{
  "name": "SafePet Strap - Automated AliExpress Order Fulfillment",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "safepet-fulfill",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Shopify Flow Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "command": "node /path/to/fulfillment/order_sync.js --order={{ $json.body.order_id || $json.body.order_number }}"
      },
      "id": "exec-order-sync",
      "name": "Execute AliExpress Sync",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Order processed to AliExpress\",\n  \"output\": {{ JSON.stringify($json.stdout) }}\n}"
      },
      "id": "webhook-respond",
      "name": "Respond to Shopify Flow",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Shopify Flow Webhook": {
      "main": [
        [
          {
            "node": "Execute AliExpress Sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute AliExpress Sync": {
      "main": [
        [
          {
            "node": "Respond to Shopify Flow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
