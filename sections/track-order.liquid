<script type="text/javascript" src="//www.17track.net/externalcall.js" defer="defer"></script>
<script type="text/javascript">
  function switchTrackTab(mode) {
    var btnTracking = document.getElementById('tab-btn-tracking');
    var btnOrder = document.getElementById('tab-btn-order');
    var paneTracking = document.getElementById('pane-tracking');
    var paneOrder = document.getElementById('pane-order');
    var errorBox = document.getElementById('safepetAlertError');
    if (errorBox) errorBox.style.display = 'none';

    if (mode === 'tracking') {
      btnTracking.classList.add('active');
      btnOrder.classList.remove('active');
      paneTracking.classList.add('active');
      paneOrder.classList.remove('active');
    } else {
      btnOrder.classList.add('active');
      btnTracking.classList.remove('active');
      paneOrder.classList.add('active');
      paneTracking.classList.remove('active');
    }
  }

  function doTrackSafePet() {
    var input = document.getElementById("YQNum");
    var errorBox = document.getElementById("safepetAlertError");
    var carriersBox = document.getElementById("safepetQuickCarriers");
    var num = (input ? input.value : "").trim();

    if (!num) {
      if (errorBox) {
        errorBox.textContent = "Please enter your tracking number (found in your shipping confirmation email).";
        errorBox.style.display = "block";
      }
      if (input) input.focus();
      return;
    }

    if (errorBox) {
      errorBox.style.display = "none";
    }

    // Populate direct carrier fallback links
    var cleanNum = encodeURIComponent(num);
    var uspsLink = document.getElementById("uspsDirectLink");
    if (uspsLink) uspsLink.href = "https://tools.usps.com/go/TrackConfirmAction?tLabels=" + cleanNum;
    
    var yqLink = document.getElementById("seventeenTrackLink");
    if (yqLink) yqLink.href = "https://t.17track.net/en#nums=" + cleanNum;

    var parcelsLink = document.getElementById("parcelsAppCover");
    if (parcelsLink) parcelsLink.href = "https://parcelsapp.com/en/tracking/" + cleanNum;

    if (carriersBox) {
      carriersBox.style.display = "block";
    }

    if (typeof YQV5 !== "undefined" && YQV5.trackSingle) {
      try {
        YQV5.trackSingle({
          YQ_ContainerId: "YQContainer",
          YQ_Height: 580,
          YQ_Fc: "0",
          YQ_Lang: "en",
          YQ_Num: num
        });
      } catch (e) {
        console.error("17Track embed error:", e);
      }
    } else {
      // If script is delayed or blocked by adblock, scroll to carrier chips
      window.open("https://t.17track.net/en#nums=" + cleanNum, "_blank");
    }
  }

  function lookupOrderSafePet() {
    var orderNum = (document.getElementById("orderNumberInput").value || "").trim();
    var email = (document.getElementById("orderEmailInput").value || "").trim();
    var alertBox = document.getElementById("safepetOrderAlert");

    if (!orderNum) {
      alertBox.className = "safepet-alert-box safepet-alert-error";
      alertBox.textContent = "Please enter your SafePet order number (e.g. #SPS941260).";
      alertBox.style.display = "block";
      return;
    }

    alertBox.className = "safepet-alert-box safepet-alert-info";
    alertBox.innerHTML = "<strong>Order " + orderNum + " Status:</strong> Orders placed within the last 1–2 business days are currently being inspected and securely packaged at our fulfillment center. Once the shipping label is scanned by the postal carrier, your live tracking number is emailed immediately. <br><br>Need immediate dispatch details? Click below to email our priority team: <br><a href='mailto:support@safepetstrap.com?subject=Inquiry%20For%20Order%20" + encodeURIComponent(orderNum) + "&body=Hi%20SafePet%20Team%2C%20please%20check%20the%20status%20of%20my%20order%20" + encodeURIComponent(orderNum) + "%20for%20email%20" + encodeURIComponent(email) + ".' style='color:#1E40AF; font-weight:700; text-decoration:underline; display:inline-block; margin-top:8px;'>&rarr; Request Instant Status Update via Email</a>";
    alertBox.style.display = "block";
  }

  function toggleTrackFaq(btn) {
    var item = btn.parentElement;
    item.classList.toggle("open");
  }
</script>

