          "settings": {
            "initial": "M",
            "name_descriptor": "Marcus D. | Dad of active 5yo twins",
            "quote": "Bedtime used to take 2 hours. The routine checklist turned it into a 15-minute breeze."
          }
        },
        {
          "type": "testimonial_notification",
          "settings": {
            "initial": "R",
            "name_descriptor": "Rachel W. | Mom of sibling rivals (5 & 7)",
            "quote": "They actually shared toys without me refereeing. Sibling peace is real!"
          }
        },
        {
          "type": "testimonial_notification",
          "settings": {
            "initial": "K",
            "name_descriptor": "Katie M. | Mom of messy 8yo boy",
            "quote": "He cleaned his entire room without being asked once. I had to double-check it!"
          }
        },
        {
