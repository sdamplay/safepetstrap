{%- comment -%} TinyThrive — Kids Life Skills Landing {%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="wld-kls-root" id="wld-kls-{{ section.id }}">

{% style %}
  #wld-kls-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    margin-top: {{ section.settings.margin_top | default: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | default: 0 }}px;
    background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
    color: {{ section.settings.text_color | default: '#2D2D2D' }};
    font-size: {{ section.settings.font_size_base | default: 16 }}px;
  }

  /* Headline styling overrides */
  #wld-kls-{{ section.id }} .kls-hero-headline {
    font-size: {{ section.settings.headline_font_size | default: 42 }}px;
    color: {{ section.settings.headline_color | default: '#2D2D2D' }};
    margin-top: {{ section.settings.headline_margin_top | default: 0 }}px;
    margin-bottom: {{ section.settings.headline_margin_bottom | default: 0 }}px;
  }

  /* Rating styling overrides */
  #wld-kls-{{ section.id }} .kls-hero-stars {
    font-size: {{ section.settings.rating_font_size | default: 16 }}px;
    color: {{ section.settings.rating_star_color | default: '#F5B800' }};
  }
  #wld-kls-{{ section.id }} .kls-hero-rating-text {
    font-size: calc({{ section.settings.rating_font_size | default: 16 }}px - 2px);
    color: {{ section.settings.rating_color | default: '#6B6B6B' }};
  }
  #wld-kls-{{ section.id }} .kls-hero-rating {
    margin-top: {{ section.settings.rating_margin_top | default: 0 }}px;
    margin-bottom: {{ section.settings.rating_margin_bottom | default: 0 }}px;
  }

  /* Price styling overrides */
  #wld-kls-{{ section.id }} .kls-hero-price-row {
    margin-top: {{ section.settings.price_margin_top | default: 0 }}px;
    margin-bottom: {{ section.settings.price_margin_bottom | default: 0 }}px;
  }
  #wld-kls-{{ section.id }} .kls-hero-price-sale {
    font-size: {{ section.settings.price_sale_font_size | default: 32 }}px;
    color: {{ section.settings.price_sale_color | default: '#D0021B' }};
  }
  #wld-kls-{{ section.id }} .kls-hero-price-original {
    font-size: {{ section.settings.price_original_font_size | default: 18 }}px;
    color: {{ section.settings.price_original_color | default: '#6B6B6B' }};
  }

  /* Benefits list styling overrides */
  #wld-kls-{{ section.id }} .kls-hero-benefits {
    margin-top: {{ section.settings.benefits_margin_top | default: 0 }}px;
    margin-bottom: {{ section.settings.benefits_margin_bottom | default: 0 }}px;
  }
  #wld-kls-{{ section.id }} .kls-hero-benefit {
    font-size: {{ section.settings.benefits_font_size | default: 16 }}px;
    color: {{ section.settings.benefits_color | default: '#2D2D2D' }};
  }
  #wld-kls-{{ section.id }} .kls-hero-benefit-icon {
    color: {{ section.settings.benefits_icon_color | default: '#E89BA0' }};
  }
  @media screen and (max-width: 767px) {
    #wld-kls-{{ section.id }} .kls-hero-benefit {
      font-size: 12px !important;
    }
  }

  /* CTA Button styling overrides */
  #wld-kls-{{ section.id }} .kls-hero-cta {
    font-size: {{ section.settings.cta_font_size | default: 18 }}px;
    background-color: {{ section.settings.cta_bg_color | default: '#D47A82' }};
    color: {{ section.settings.cta_text_color | default: '#FFFFFF' }};
  }
  #wld-kls-{{ section.id }} .product-form.main-product-form {
    margin-top: {{ section.settings.cta_margin_top | default: 0 }}px;
    margin-bottom: {{ section.settings.cta_margin_bottom | default: 0 }}px;
  }

  /* Testimonial Card styling overrides */
  #wld-kls-{{ section.id }} .kls-hero-testimonial {
    background-color: {{ section.settings.testimonial_bg_color | default: '#FFF5F6' }};
    color: {{ section.settings.testimonial_text_color | default: '#2D2D2D' }};
    margin-top: {{ section.settings.testimonial_margin_top | default: 0 }}px;
    margin-bottom: {{ section.settings.testimonial_margin_bottom | default: 0 }}px;
  }
  #wld-kls-{{ section.id }} .kls-hero-testimonial-quote {
    color: {{ section.settings.testimonial_text_color | default: '#2D2D2D' }};
  }
  #wld-kls-{{ section.id }} .kls-hero-testimonial-name {
    color: {{ section.settings.testimonial_text_color | default: '#2D2D2D' }};
  }

  /* General scaling fallback for other sections */
  #wld-kls-{{ section.id }} .kls-faq-heading,
  #wld-kls-{{ section.id }} .kls-testimonials-heading,
  #wld-kls-{{ section.id }} .kls-ready-heading,
  #wld-kls-{{ section.id }} .kls-grow-heading,
  #wld-kls-{{ section.id }} .kls-stats-heading,
  #wld-kls-{{ section.id }} .kls-comparison-heading,
  #wld-kls-{{ section.id }} .kls-guarantee-heading {
    font-size: calc({{ section.settings.font_size_base | default: 16 }}px * 2.0);
  }

  #wld-kls-{{ section.id }} .kls-faq-question,
  #wld-kls-{{ section.id }} .kls-ready-body,
  #wld-kls-{{ section.id }} .kls-grow-body,
  #wld-kls-{{ section.id }} .kls-grow-quote,
  #wld-kls-{{ section.id }} .kls-testimonial-body,
  #wld-kls-{{ section.id }} .kls-guarantee-body {
    font-size: {{ section.settings.font_size_base | default: 16 }}px;
  }

  #wld-kls-{{ section.id }} .kls-hero-trust,
  #wld-kls-{{ section.id }} .kls-testimonial-author,
  #wld-kls-{{ section.id }} .kls-stats-footnote {
    font-size: calc({{ section.settings.font_size_base | default: 16 }}px * 0.875);
  }
{% endstyle %}

  
