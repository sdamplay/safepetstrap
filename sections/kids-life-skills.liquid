{%- comment -%} TinyThrive — Kids Life Skills Landing {%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="wld-kls-root" id="wld-kls-{{ section.id }}">

  
  {{ 'kids-life-skills.css' | asset_url | stylesheet_tag }}


  <section class="kls-hero">
    <div class="kls-hero-container">
      <div class="kls-hero-left">
        <div class="kls-hero-gallery" data-wld-gallery>
          <div class="kls-hero-image" data-wld-main>
            {%- if section.settings.hero_main_image != blank -%}
              {{ section.settings.hero_main_image | image_url: width: 1200 | image_tag: widths: '400,600,900,1200', sizes: '(min-width: 900px) 500px, 100vw', loading: 'eager', class: 'kls-gallery-img', alt: section.settings.hero_main_image.alt | default: section.settings.hero_headline }}
            {%- endif -%}
            {%- if section.settings.hero_badge_tl != blank -%}
              <span class="kls-hero-badge kls-hero-badge-tl">{{ section.settings.hero_badge_tl }}</span>
            {%- endif -%}
            {%- if section.settings.hero_badge_tc != blank -%}
              <span class="kls-hero-badge kls-hero-badge-tc">{{ section.settings.hero_badge_tc }}</span>
            {%- endif -%}
            {%- if section.settings.hero_badge_tr != blank -%}
              <span class="kls-hero-badge kls-hero-badge-tr">{{ section.settings.hero_badge_tr }}</span>
            {%- endif -%}
          </div>
          <div class="kls-hero-thumbs">
            {%- if section.settings.hero_thumb_1 != blank -%}
              <div class="kls-hero-thumb" data-wld-thumb>
                {{ section.settings.hero_thumb_1 | image_url: width: 200 | image_tag: widths: '200,400', sizes: '80px', loading: 'lazy', class: 'kls-thumb-img', alt: 'Gallery thumbnail 1' }}
              </div>
            {%- else -%}
              <div class="kls-hero-thumb" data-wld-thumb></div>
            {%- endif -%}
            {%- if section.settings.hero_thumb_2 != blank -%}
              <div class="kls-hero-thumb" data-wld-thumb>
                {{ section.settings.hero_thumb_2 | image_url: width: 200 | image_tag: widths: '200,400', sizes: '80px', loading: 'lazy', class: 'kls-thumb-img', alt: 'Gallery thumbnail 2' }}
              </div>
            {%- else -%}
              <div class="kls-hero-thumb" data-wld-thumb></div>
            {%- endif -%}
            {%- if section.settings.hero_thumb_3 != blank -%}
              <div class="kls-hero-thumb" data-wld-thumb>
                {{ section.settings.hero_thumb_3 | image_url: width: 200 | image_tag: widths: '200,400', sizes: '80px', loading: 'lazy', class: 'kls-thumb-img', alt: 'Gallery thumbnail 3' }}
              </div>
            {%- else -%}
              <div class="kls-hero-thumb" data-wld-thumb></div>
            {%- endif -%}
            {%- if section.settings.hero_thumb_4 != blank -%}
              <div class="kls-hero-thumb" data-wld-thumb>
                {{ section.settings.hero_thumb_4 | image_url: width: 200 | image_tag: widths: '200,400', sizes: '80px', loading: 'lazy', class: 'kls-thumb-img', alt: 'Gallery thumbnail 4' }}
              </div>
            {%- else -%}
              <div class="kls-hero-thumb" data-wld-thumb></div>
            {%- endif -%}
          </div>
        </div>
      </div>
      <div class="kls-hero-right">
        <div class="kls-hero-rating">
          <span class="kls-hero-stars">★★★★★</span>
          <span class="kls-hero-rating-text">{{ section.settings.hero_rating_text }}</span>
        </div>
        <h1 class="kls-hero-headline">{{ section.settings.hero_headline }}</h1>
        <div class="kls-hero-price-row">
          <span class="kls-hero-price-sale">{{ section.settings.hero_price_sale }}</span>
          <span class="kls-hero-price-original">{{ section.settings.hero_price_original }}</span>
          {%- if section.settings.hero_save_pill != blank -%}
            <span class="kls-hero-save-pill">{{ section.settings.hero_save_pill }}</span>
          {%- endif -%}
        </div>
        <ul class="kls-hero-benefits">
          {%- if section.settings.hero_benefit_1 != blank -%}
            <li class="kls-hero-benefit"><span class="kls-hero-benefit-icon">♥</span><span>{{ section.settings.hero_benefit_1 }}</span></li>
          {%- endif -%}
          {%- if section.settings.hero_benefit_2 != blank -%}
            <li class="kls-hero-benefit"><span class="kls-hero-benefit-icon">♥</span><span>{{ section.settings.hero_benefit_2 }}</span></li>
          {%- endif -%}
          {%- if section.settings.hero_benefit_3 != blank -%}
            <li class="kls-hero-benefit"><span class="kls-hero-benefit-icon">♥</span><span>{{ section.settings.hero_benefit_3 }}</span></li>
          {%- endif -%}
        </ul>

        {%- assign product = section.settings.product -%}
        {%- if product != blank -%}
          {%- assign product_form_id = 'ProductForm-' | append: section.id -%}
          <product-form
            id="ProductForm-{{ section.id }}"
            class="product-form main-product-form"
            data-section="{{ section.id }}"
            data-options="{{ product.options | join: ',' }}"
            data-main="true"
          >
            <div class="product-form__error-message-wrapper" role="alert" hidden>
              <svg
                aria-hidden="true"
                focusable="false"
                class="icon icon-error"
                viewBox="0 0 13 13"
              >
                <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
                <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
                <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
                <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
              </svg>
              <span class="product-form__error-message"></span>
            </div>

            {%- form 'product',
              product,
              id: product_form_id,
              class: 'form',
              novalidate: 'novalidate',
              data-type: 'add-to-cart-form'
            -%}
              <div class="hidden product-form__variants" id="product-form-{{ section.id }}__variants" data-values=""></div>
              <input
                type="hidden"
                name="id"
                value="{{ product.selected_or_first_available_variant.id }}"
                class="product-variant-id"
              >
              <input type="hidden" name="quantity" value="1">

              <div class="product-form__buttons">
                <button
                  id="ProductSubmitButton-{{ section.id }}"
                  type="submit"
                  name="add"
                  class="kls-hero-cta atc-button product-form__submit button button--full-width button--margin-x main-product-atc"
                  {% if product.selected_or_first_available_variant.available == false %}
                    disabled
                    data-unavailable="true"
                  {% endif %}
                  data-required-fields="0"
                  data-valid-fields="0"
                >
                  <span class="main-atc__error" style="display:none;"></span>
                  <span class="main-atc__label button__label">
                    <span class="main-atc__label__text">
                      {%- if product.selected_or_first_available_variant.available == false -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- else -%}
                        {{ section.settings.hero_cta_label }}
                      {%- endif -%}
                    </span>
                  </span>
                  <div class="loading-overlay__spinner hidden">
                    <svg
                      aria-hidden="true"
                      focusable="false"
                      class="spinner"
                      viewBox="0 0 66 66"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                    </svg>
                  </div>
                </button>
              </div>
            {%- endform -%}
          </product-form>
        {%- else -%}
          <button type="button" class="kls-hero-cta">{{ section.settings.hero_cta_label }}</button>
          <div class="kls-no-product-notice">⚠️ <strong>Preview mode.</strong> Select a product in section settings to activate Add to Cart.</div>
        {%- endif -%}

        <div class="kls-hero-trust">
          <span class="kls-hero-trust-check">✓</span>
          <span>{{ section.settings.hero_trust_text }}</span>
        </div>
        {%- if section.settings.hero_guarantee_pill != blank -%}
          <span class="kls-hero-guarantee">{{ section.settings.hero_guarantee_pill }}</span>
        {%- endif -%}
        <div class="kls-hero-testimonial">
          <div class="kls-hero-testimonial-top">
            {%- if section.settings.hero_testimonial_avatar != blank -%}
              <div class="kls-hero-testimonial-avatar">
                {{ section.settings.hero_testimonial_avatar | image_url: width: 88 | image_tag: widths: '44,88', sizes: '44px', loading: 'lazy', class: 'kls-avatar-img', alt: section.settings.hero_testimonial_name }}
              </div>
            {%- else -%}
              <div class="kls-hero-testimonial-avatar"></div>
            {%- endif -%}
            <p class="kls-hero-testimonial-quote">{{ section.settings.hero_testimonial_quote }}</p>
          </div>
          <div class="kls-hero-testimonial-meta">
            <span class="kls-hero-testimonial-name">{{ section.settings.hero_testimonial_name }}</span>
            <span class="kls-hero-testimonial-stars">★★★★★</span>
          </div>
          <div class="kls-hero-testimonial-dots">
            <span class="kls-hero-testimonial-dot kls-hero-testimonial-dot-active"></span>
            <span class="kls-hero-testimonial-dot"></span>
            <span class="kls-hero-testimonial-dot"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="kls-faq">
    <div class="kls-faq-container">
      <h2 class="kls-faq-heading">{{ section.settings.faq_heading }}</h2>
      <div class="kls-faq-list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <details class="kls-faq-row" {{ block.shopify_attributes }}>
              <summary class="kls-faq-summary">
                <div class="kls-faq-question">
                  <span class="kls-faq-emoji">{{ block.settings.emoji }}</span>
                  <span>{{ block.settings.question }}</span>
                </div>
                <span class="kls-faq-chevron">⌄</span>
              </summary>
              <div class="kls-faq-answer">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="kls-ready">
    <div class="kls-ready-inner">
      <div class="kls-ready-image">
        {%- if section.settings.ready_image != blank -%}
          {{ section.settings.ready_image | image_url: width: 1200 | image_tag: widths: '400,600,900,1200', sizes: '(min-width: 900px) 500px, 100vw', loading: 'lazy', class: 'kls-ready-img', alt: section.settings.ready_heading }}
        {%- endif -%}
      </div>
      <div class="kls-ready-content">
        <h2 class="kls-ready-heading">{{ section.settings.ready_heading }}</h2>
        <p class="kls-ready-body">{{ section.settings.ready_body }}</p>
        <a href="{{ section.settings.ready_cta_url | default: '#wld-kls-' | append: section.id }}" class="kls-ready-cta">{{ section.settings.ready_cta_label }}</a>
      </div>
    </div>
  </section>

  <section class="kls-grow">
    <div class="kls-grow-inner">
      <div class="kls-grow-content">
        <h2 class="kls-grow-heading">{{ section.settings.grow_heading }}</h2>
        <p class="kls-grow-body">{{ section.settings.grow_body }}</p>
      </div>
      <div class="kls-grow-image">
        <p class="kls-grow-quote">{{ section.settings.grow_quote }}</p>
        <div class="kls-grow-collage">
          <div class="kls-grow-thumb">
            {%- if section.settings.grow_thumb_1 != blank -%}
              {{ section.settings.grow_thumb_1 | image_url: width: 400 | image_tag: widths: '200,400', sizes: '150px', loading: 'lazy', class: 'kls-grow-thumb-img', alt: 'Worksheet 1' }}
            {%- endif -%}
          </div>
          <div class="kls-grow-thumb">
            {%- if section.settings.grow_thumb_2 != blank -%}
              {{ section.settings.grow_thumb_2 | image_url: width: 400 | image_tag: widths: '200,400', sizes: '150px', loading: 'lazy', class: 'kls-grow-thumb-img', alt: 'Worksheet 2' }}
            {%- endif -%}
          </div>
          <div class="kls-grow-thumb">
            {%- if section.settings.grow_thumb_3 != blank -%}
              {{ section.settings.grow_thumb_3 | image_url: width: 400 | image_tag: widths: '200,400', sizes: '150px', loading: 'lazy', class: 'kls-grow-thumb-img', alt: 'Worksheet 3' }}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="kls-testimonials">
    <div class="kls-testimonials-inner">
      <h2 class="kls-testimonials-heading">{{ section.settings.testimonials_heading }}</h2>
      <div class="kls-testimonials-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'testimonial' -%}
            <div class="kls-testimonial-card" {{ block.shopify_attributes }}>
              <div class="kls-testimonial-badge">"</div>
              <div class="kls-testimonial-stars">★★★★★</div>
              <h3 class="kls-testimonial-title">{{ block.settings.title }}</h3>
              <p class="kls-testimonial-body">{{ block.settings.body }}</p>
              <p class="kls-testimonial-author"><span class="kls-testimonial-author-name">{{ block.settings.author_name }}</span> | {{ block.settings.author_tag }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="kls-stats">
    <div class="kls-stats-inner">
      <div>
        <h2 class="kls-stats-heading">{{ section.settings.stats_heading }}</h2>
      </div>
      <div>
        <div class="kls-stats-rows">
          <div class="kls-stat-row">
            <div class="kls-stat-badge">{{ section.settings.stat_1_value }}</div>
            <p class="kls-stat-desc">{{ section.settings.stat_1_desc }}</p>
          </div>
          <div class="kls-stat-row">
            <div class="kls-stat-badge">{{ section.settings.stat_2_value }}</div>
            <p class="kls-stat-desc">{{ section.settings.stat_2_desc }}</p>
          </div>
          <div class="kls-stat-row">
            <div class="kls-stat-badge">{{ section.settings.stat_3_value }}</div>
            <p class="kls-stat-desc">{{ section.settings.stat_3_desc }}</p>
          </div>
        </div>
        <p class="kls-stats-footnote">{{ section.settings.stats_footnote }}</p>
      </div>
    </div>
  </section>

  <section class="kls-comparison">
    <div class="kls-comparison-inner">
      <h2 class="kls-comparison-heading">{{ section.settings.comparison_heading }}</h2>
      <div class="kls-comparison-table">
        <div class="kls-comparison-row kls-comparison-row-header">
          <div class="kls-comparison-feature">&nbsp;</div>
          <div class="kls-comparison-brand-header">{{ section.settings.comparison_brand_label }}</div>
          <div class="kls-comparison-others-header">{{ section.settings.comparison_others_label }}</div>
        </div>
        {%- assign features = section.settings.comparison_features | newline_to_br | split: '<br />' -%}
        {%- for feature in features -%}
          {%- assign clean = feature | strip -%}
          {%- if clean != blank -%}
            <div class="kls-comparison-row">
              <div class="kls-comparison-feature">{{ clean }}</div>
              <div class="kls-comparison-cell-brand"><span class="kls-comparison-check">✓</span></div>
              <div class="kls-comparison-cell-others"><span class="kls-comparison-x">✕</span></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="kls-guarantee">
    <div class="kls-guarantee-inner">
      <h2 class="kls-guarantee-heading">{{ section.settings.guarantee_heading }}</h2>
      <p class="kls-guarantee-body">{{ section.settings.guarantee_body }}</p>
      <a href="{{ section.settings.guarantee_cta_url | default: '#wld-kls-' | append: section.id }}" class="kls-guarantee-cta">{{ section.settings.guarantee_cta_label }}</a>
    </div>
  </section>

  

</div>






<script>
(function(){
  function imgOf(el){ return el ? (el.tagName === 'IMG' ? el : el.querySelector('img')) : null; }
  function wireWldGallery(gallery){
    var main = imgOf(gallery.querySelector('[data-wld-main]'));
    if(!main) return;
    gallery.querySelectorAll('[data-wld-thumb]').forEach(function(el){
      var fresh = el.cloneNode(true);
      el.parentNode.replaceChild(fresh, el);
      fresh.style.cursor = 'pointer';
      fresh.addEventListener('click', function(){
        var t = imgOf(fresh);
        if(!t) return;
        var src = t.getAttribute('src');
        if(src){ main.setAttribute('src', src.replace(/([?&])width=\d+/, '$1width=1200')); }
        main.removeAttribute('srcset');
      });
    });
  }
  function initWldGalleries(){
    document.querySelectorAll('[data-wld-gallery]').forEach(wireWldGallery);
  }
  initWldGalleries();
  document.addEventListener('shopify:section:load', initWldGalleries);
})();
</script>

{% schema %}
{
  "name": "TinyThrive Life Skills",
  "tag": "section",
  "class": "wld-section",
  "settings": [
    { "type": "header", "content": "🛒 Product & Buy Box" },
    { "type": "product", "id": "product", "label": "Product (for cart)" },

    { "type": "header", "content": "🖼️ Hero Gallery" },
    { "type": "image_picker", "id": "hero_main_image", "label": "Main hero image" },
    { "type": "image_picker", "id": "hero_thumb_1", "label": "Thumbnail 1" },
    { "type": "image_picker", "id": "hero_thumb_2", "label": "Thumbnail 2" },
    { "type": "image_picker", "id": "hero_thumb_3", "label": "Thumbnail 3" },
    { "type": "image_picker", "id": "hero_thumb_4", "label": "Thumbnail 4" },
    { "type": "text", "id": "hero_badge_tl", "label": "Badge top-left", "default": "150+ Pages" },
    { "type": "text", "id": "hero_badge_tc", "label": "Badge top-center (pink)", "default": "Loved By Busy Parents" },
    { "type": "text", "id": "hero_badge_tr", "label": "Badge top-right", "default": "6,200+ Happy Parents" },

    { "type": "header", "content": "💰 Hero Buy Box Copy" },
    { "type": "text", "id": "hero_rating_text", "label": "Rating text", "default": "(2,184 verified reviews)" },
    { "type": "text", "id": "hero_headline", "label": "Headline", "default": "Raise A Confident, Capable Kid — One 10-Minute Activity At A Time" },
    { "type": "text", "id": "hero_price_sale", "label": "Sale price", "default": "$0.00" },
    { "type": "text", "id": "hero_price_original", "label": "Original price", "default": "$58.00" },
    { "type": "text", "id": "hero_save_pill", "label": "Save pill", "default": "SAVE 100%" },
    { "type": "text", "id": "hero_benefit_1", "label": "Benefit 1", "default": "150+ pages of age-by-age activities — zero guesswork, zero prep" },
    { "type": "text", "id": "hero_benefit_2", "label": "Benefit 2", "default": "Turns chores, manners & big feelings into games kids ask for" },
    { "type": "text", "id": "hero_benefit_3", "label": "Benefit 3", "default": "Built around real child-development milestones, not Pinterest guesses" },
    { "type": "text", "id": "hero_cta_label", "label": "CTA label", "default": "CLAIM MY FREE BUNDLE" },
    { "type": "text", "id": "hero_trust_text", "label": "Trust text", "default": "100% digital. Delivered to your inbox in minutes — nothing to wait for, nothing to assemble." },
    { "type": "text", "id": "hero_guarantee_pill", "label": "Guarantee pill", "default": "90-Day Money-Back Guarantee" },

    { "type": "header", "content": "💬 Hero Testimonial" },
    { "type": "image_picker", "id": "hero_testimonial_avatar", "label": "Avatar image" },
    { "type": "textarea", "id": "hero_testimonial_quote", "label": "Quote", "default": "My son used to melt down every morning over getting dressed. Three weeks into this workbook, he picks his own clothes, makes his bed, and told me he's 'a big kid now.' I teared up reading that page." },
    { "type": "text", "id": "hero_testimonial_name", "label": "Name", "default": "Megan T., mom of 2 (ages 5 & 8)" },

    { "type": "header", "content": "❓ FAQ Section" },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Still Have Questions? We've Got You." },
    { "type": "paragraph", "content": "Add FAQ items as blocks below." },

    { "type": "header", "content": "🎯 Ready Section (Image + Copy + CTA)" },
    { "type": "image_picker", "id": "ready_image", "label": "Image" },
    { "type": "text", "id": "ready_heading", "label": "Heading", "default": "Ready To Swap Power Struggles For 'I Got It, Mom'?" },
    { "type": "textarea", "id": "ready_body", "label": "Body", "default": "No more reminders. No more nagging. Just print a page, hand it over, and watch your kid take it from there. Every activity quietly builds the confidence, responsibility, and emotional skills behind those proud 'I did it myself' moments." },
    { "type": "text", "id": "ready_cta_label", "label": "CTA label", "default": "YES — I WANT THE ROADMAP" },
    { "type": "url", "id": "ready_cta_url", "label": "CTA URL" },

    { "type": "header", "content": "🌱 Grow Section" },
    { "type": "text", "id": "grow_heading", "label": "Heading", "default": "Stop Guessing 🌱 Start Growing With A Plan ✨" },
    { "type": "textarea", "id": "grow_body", "label": "Body", "default": "From tying shoelaces to naming big feelings, this bundle walks your child through the exact skills that build independence, one small page at a time. Age-by-age, skill-by-skill, no guesswork required." },
    { "type": "textarea", "id": "grow_quote", "label": "Quote", "default": "The moment a child finishes something on their own, ties the shoe, makes the bed, says 'I'm frustrated' instead of screaming, something shifts. That quiet pride is where real confidence starts." },
