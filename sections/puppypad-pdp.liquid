{{ 'puppy-pad-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'puppy-pad-pdp.js' | asset_url }}" defer></script>

{%- liquid
  assign small_img = 'puppy-pad-size-s.jpg' | asset_url
  assign medium_img = 'puppy-pad-size-m.jpg' | asset_url
  assign large_img = 'puppy-pad-size-l.jpg' | asset_url

  # Build JSON variant mapping if on a Shopify product
  assign variant_map_json = '{}'
  if product
    assign map_parts = ''
    for variant in product.variants
      assign title_lower = variant.title | downcase
      if title_lower contains 'small' or title_lower contains 's'
        assign map_parts = map_parts | append: '"small":' | append: variant.id | append: ','
      elsif title_lower contains 'medium' or title_lower contains 'm'
        assign map_parts = map_parts | append: '"medium":' | append: variant.id | append: ','
      elsif title_lower contains 'large' or title_lower contains 'l'
        assign map_parts = map_parts | append: '"large":' | append: variant.id | append: ','
      endif
    endfor
    if map_parts != ''
      assign map_clean = map_parts | slice: 0, -1
      assign variant_map_json = '{' | append: map_clean | append: '}'
    endif
  endif
-%}

