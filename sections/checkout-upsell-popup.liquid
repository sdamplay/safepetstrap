  </style>

  <script>
    (function() {
      // Config data attributes fallback
      var upsellProductId = {{ upsell_product.id | default: 9810334613734 }};
      var triggerProductIds = [{% if trigger_ids != blank %}{{ trigger_ids }}{% endif %}];
      var discountCode2x = {{ section.settings.discount_code_2x | default: 'HARNESS2X' | json }};
      var discountCode3x = {{ section.settings.discount_code_3x | default: 'HARNESS3X' | json }};
      
      var currentQty = 1;
      var activeVariantId1 = null;
      var activeVariantId2 = null;
      var activeVariantId3 = null;
      var activeSize1 = 'S';
      var activeSize2 = 'M';
      var activeSize3 = 'L';
      var activeWeight1 = '10–28 Lbs';
      var activeWeight2 = '28–50 Lbs';
      var activeWeight3 = '45–70 Lbs';

      var pricingTiers = {
        1: { total: 24.95, unit: 24.95, compare: 42.99, compareUnit: 42.99, discount: 'Save 42%', hint: 'Standard Single Pack' },
        2: { total: 45.90, unit: 22.95, compare: 85.98, compareUnit: 42.99, discount: 'Save 47%', hint: 'Save $4.00 ($22.95/ea)' },
        3: { total: 59.85, unit: 19.95, compare: 128.97, compareUnit: 42.99, discount: 'Save 54%', hint: 'Save $15.00 ($19.95/ea)' }
      };

      var interceptedCheckoutBtn = null;
      var bypassPopup = false;
      var timerInterval = null;

      function updateUpsellPricingAndCTA() {
        var displayPriceEl = document.getElementById('checkoutUpsellDisplayPrice');
        var displayCompareEl = document.getElementById('checkoutUpsellDisplayCompare');
        var displayDiscountEl = document.getElementById('checkoutUpsellDisplayDiscount');
        var savingsHintEl = document.getElementById('checkoutUpsellSavingsHint');
        var addBtnMain = document.getElementById('checkoutUpsellAddBtnText');
        var addBtnSub = document.getElementById('checkoutUpsellAddBtnSubtext');
        var sizeLabel1 = document.getElementById('checkoutUpsellSizeLabel1');
        var selectedSizeText1 = document.getElementById('selectedSizeText1');
        var selectedSizeText2 = document.getElementById('selectedSizeText2');
        var selectedSizeText3 = document.getElementById('selectedSizeText3');
        var dog2Wrap = document.getElementById('checkoutUpsellDog2Wrap');
        var dog3Wrap = document.getElementById('checkoutUpsellDog3Wrap');
        
        var tier = pricingTiers[currentQty] || pricingTiers[1];
        
        // Show unit price prominently in product row
        if (displayPriceEl) {
          displayPriceEl.textContent = '$' + tier.unit.toFixed(2) + (currentQty > 1 ? ' /ea' : '');
        }
        if (displayCompareEl) {
          displayCompareEl.textContent = '$' + tier.compareUnit.toFixed(2) + (currentQty > 1 ? ' /ea' : '');
        }
        if (displayDiscountEl) displayDiscountEl.textContent = tier.discount;
        if (savingsHintEl) savingsHintEl.textContent = tier.hint;
        
        var cleanSize1 = (activeSize1 || 'S').split('(')[0].trim();
        var cleanSize2 = (activeSize2 || 'M').split('(')[0].trim();
        var cleanSize3 = (activeSize3 || 'L').split('(')[0].trim();

        var size1Display = cleanSize1 + (activeWeight1 ? ' (' + activeWeight1 + ')' : '');
        var size2Display = cleanSize2 + (activeWeight2 ? ' (' + activeWeight2 + ')' : '');
        var size3Display = cleanSize3 + (activeWeight3 ? ' (' + activeWeight3 + ')' : '');

        if (selectedSizeText1) selectedSizeText1.textContent = size1Display;
        if (selectedSizeText2) selectedSizeText2.textContent = size2Display;
        if (selectedSizeText3) selectedSizeText3.textContent = size3Display;
        
        if (currentQty === 1) {
          if (sizeLabel1) sizeLabel1.innerHTML = 'Select Size: <span class="checkout-upsell-active-size-name" id="selectedSizeText1">' + size1Display + '</span>';
          if (dog2Wrap) dog2Wrap.style.display = 'none';
          if (dog3Wrap) dog3Wrap.style.display = 'none';
          if (addBtnMain) addBtnMain.textContent = "⚡ YES! ADD TO MY ORDER — $" + tier.total.toFixed(2);
          if (addBtnSub) addBtnSub.textContent = "✓ Size " + cleanSize1 + " Selected • Protects Neck & Spine From Sudden Brakes";
        } else if (currentQty === 2) {
          if (sizeLabel1) sizeLabel1.innerHTML = '🐶 Harness #1 Size: <span class="checkout-upsell-active-size-name" id="selectedSizeText1">' + size1Display + '</span>';
          if (dog2Wrap) dog2Wrap.style.display = 'block';
          if (dog3Wrap) dog3Wrap.style.display = 'none';
          if (addBtnMain) addBtnMain.textContent = "⚡ YES! ADD 2x TO MY ORDER — $" + tier.total.toFixed(2);
          if (addBtnSub) addBtnSub.textContent = "✓ Sizes (" + cleanSize1 + " & " + cleanSize2 + ") • Complete No-Choke Protection For Both Pups";
        } else {
          if (sizeLabel1) sizeLabel1.innerHTML = '🐶 Harness #1 Size: <span class="checkout-upsell-active-size-name" id="selectedSizeText1">' + size1Display + '</span>';
          if (dog2Wrap) dog2Wrap.style.display = 'block';
          if (dog3Wrap) dog3Wrap.style.display = 'block';
          if (addBtnMain) addBtnMain.textContent = "⚡ YES! ADD 3x TO MY ORDER — $" + tier.total.toFixed(2);
          if (addBtnSub) addBtnSub.textContent = "✓ Sizes (" + cleanSize1 + ", " + cleanSize2 + ", " + cleanSize3 + ") • Total Protection For All Your Fur Babies";
        }
      }
      
      function startCountdown() {
        var timerEl = document.getElementById('checkoutUpsellTimer');
        if (!timerEl) return;
        
        if (timerInterval) clearInterval(timerInterval);
        
        var duration = 299; // 4 minutes 59 seconds
        function updateTimer() {
          var minutes = Math.floor(duration / 60);
          var seconds = duration % 60;
          
          minutes = minutes < 10 ? '0' + minutes : minutes;
          seconds = seconds < 10 ? '0' + seconds : seconds;
          
          timerEl.textContent = minutes + ':' + seconds;
          
          if (--duration < 0) {
            clearInterval(timerInterval);
            timerEl.textContent = "00:00";
          }
        }
        
        updateTimer();
        timerInterval = setInterval(updateTimer, 1000);
      }
      
      function initUpsellPopup() {
        var modal = document.getElementById('checkoutUpsellPopup');
        var addBtn = document.getElementById('checkoutUpsellAddBtn');
        var skipBtn = document.getElementById('checkoutUpsellSkipBtn');
        var qtyCard1 = document.getElementById('checkoutUpsellQty1');
        var qtyCard2 = document.getElementById('checkoutUpsellQty2');
        var qtyCard3 = document.getElementById('checkoutUpsellQty3');
        var cardsContainer1 = document.getElementById('checkoutUpsellVariantCards1');
        var cardsContainer2 = document.getElementById('checkoutUpsellVariantCards2');
        var cardsContainer3 = document.getElementById('checkoutUpsellVariantCards3');
        
        if (!modal) return;
        
        // If modal is already active (e.g. editor preview), start countdown
        if (modal.classList.contains('active')) {
          startCountdown();
        }

        // QTY 1 vs 2 vs 3 switcher
        function setQuantity(qty) {
          currentQty = qty;
          [qtyCard1, qtyCard2, qtyCard3].forEach(function(card, idx) {
            if (!card) return;
            if (idx + 1 === qty) {
              card.classList.add('active');
            } else {
              card.classList.remove('active');
            }
          });
          updateUpsellPricingAndCTA();
        }

        if (qtyCard1) {
          qtyCard1.addEventListener('click', function(e) {
            e.preventDefault();
            setQuantity(1);
          });
        }
        if (qtyCard2) {
          qtyCard2.addEventListener('click', function(e) {
            e.preventDefault();
            setQuantity(2);
          });
        }
        if (qtyCard3) {
          qtyCard3.addEventListener('click', function(e) {
            e.preventDefault();
            setQuantity(3);
          });
        }
        
        // Bind size card selection for a dog container
        function bindCards(container, dogIndex) {
          if (!container) return;
          var cards = container.querySelectorAll('.size-pill-card');
          if (!cards || cards.length === 0) return;
          
          var preferredSize = dogIndex === 1 ? 'S' : (dogIndex === 2 ? 'M' : 'L');
          var targetCard = null;
          
          cards.forEach(function(c) {
            if (c.getAttribute('data-size') === preferredSize && !targetCard) {
              targetCard = c;
            }
          });
          
          if (!targetCard) {
            targetCard = container.querySelector('.size-pill-card.active') || cards[0];
          }
          
          cards.forEach(function(c) {
            c.classList.remove('active');
          });
          targetCard.classList.add('active');
          
          var vid = targetCard.getAttribute('data-variant-id');
          var s = targetCard.getAttribute('data-size') || preferredSize;
          var w = targetCard.getAttribute('data-weight') || '';
          if (dogIndex === 1) { activeVariantId1 = vid; activeSize1 = s; activeWeight1 = w; }
          if (dogIndex === 2) { activeVariantId2 = vid; activeSize2 = s; activeWeight2 = w; }
          if (dogIndex === 3) { activeVariantId3 = vid; activeSize3 = s; activeWeight3 = w; }
          
          container.addEventListener('click', function(event) {
            var card = event.target.closest('.size-pill-card');
            if (card) {
              cards.forEach(function(c) {
                c.classList.remove('active');
              });
              card.classList.add('active');
              var vid = card.getAttribute('data-variant-id');
              var s = card.getAttribute('data-size') || 'S';
              var w = card.getAttribute('data-weight') || '';
              if (dogIndex === 1) { activeVariantId1 = vid; activeSize1 = s; activeWeight1 = w; }
              if (dogIndex === 2) { activeVariantId2 = vid; activeSize2 = s; activeWeight2 = w; }
              if (dogIndex === 3) { activeVariantId3 = vid; activeSize3 = s; activeWeight3 = w; }
              updateUpsellPricingAndCTA();
            }
          });
        }

        bindCards(cardsContainer1, 1);
        bindCards(cardsContainer2, 2);
        bindCards(cardsContainer3, 3);

        updateUpsellPricingAndCTA();

        // Sizing Modal Popup Toggle Events
        var sizeChartTrigger = document.getElementById('checkoutUpsellSizeChartTrigger');
        var sizePopup = document.getElementById('checkoutUpsellSizePopup');
        var sizePopupClose = document.getElementById('checkoutUpsellSizePopupClose');
        
        if (sizeChartTrigger && sizePopup) {
          sizeChartTrigger.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            sizePopup.classList.add('active');
            sizePopup.setAttribute('aria-hidden', 'false');
          });
        }
        if (sizePopupClose && sizePopup) {
          sizePopupClose.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            sizePopup.classList.remove('active');
            sizePopup.setAttribute('aria-hidden', 'true');
          });
        }
        if (sizePopup) {
          sizePopup.addEventListener('click', function(e) {
            if (e.target === sizePopup) {
              sizePopup.classList.remove('active');
              sizePopup.setAttribute('aria-hidden', 'true');
            }
          });
        }
        
        var shopifyRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

        // Intercept Checkout Click
        document.addEventListener('click', function(event) {
          if (bypassPopup) return;
          
          var checkoutBtn = event.target.closest('#CartDrawer-Checkout') || 
                            event.target.closest('.cart__checkout-button') ||
                            (event.target.closest('button[name="checkout"]') || event.target.closest('input[name="checkout"]'));
          if (checkoutBtn) {
            // Check if cart already has the upsell product
            event.preventDefault();
            event.stopPropagation();
            
            interceptedCheckoutBtn = checkoutBtn;
            
            fetch(shopifyRoot + 'cart.js')
              .then(function(res) { return res.json(); })
              .then(function(cart) {
                var hasHarness = cart.items.some(function(item) {
                  return item.product_id === upsellProductId;
                });
                
                // Check if trigger product list is empty, or if at least one trigger product is in the cart
                var hasTriggerProduct = triggerProductIds.length === 0 || cart.items.some(function(item) {
                  return triggerProductIds.indexOf(item.product_id) !== -1;
                });
                
                if (hasHarness || !hasTriggerProduct || cart.item_count === 0) {
                  // Direct checkout
                  submitCheckout(checkoutBtn);
                } else {
                  // Open modal
                  modal.classList.add('active');
                  modal.setAttribute('aria-hidden', 'false');
                  startCountdown(); // Start urgency countdown
                }
              })
              .catch(function() {
                // Fallback direct checkout
                submitCheckout(checkoutBtn);
              });
          }
        }, true); // Use capture phase to intercept before theme scripts!
        
        // Add to Order & Checkout
        addBtn.addEventListener('click', function() {
          if (!activeVariantId1) return;
          
          addBtn.disabled = true;
          addBtn.innerHTML = '<span class="checkout-upsell-spinner"></span> ADDING TO ORDER...';
          
          var selectedVariants = [];
          if (currentQty >= 1 && activeVariantId1) selectedVariants.push(parseInt(activeVariantId1, 10));
          if (currentQty >= 2 && activeVariantId2) selectedVariants.push(parseInt(activeVariantId2, 10));
          if (currentQty >= 3 && activeVariantId3) selectedVariants.push(parseInt(activeVariantId3, 10));
          
          var counts = {};
          selectedVariants.forEach(function(id) {
            counts[id] = (counts[id] || 0) + 1;
          });
          
          var itemsToAdd = [];
          for (var id in counts) {
            if (counts.hasOwnProperty(id)) {
              itemsToAdd.push({ id: parseInt(id, 10), quantity: counts[id] });
            }
          }
          
          fetch(shopifyRoot + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: itemsToAdd })
          })
          .then(function(res) { return res.json(); })
          .then(function() {
            var codeToApply = '';
            if (currentQty === 2 && discountCode2x) {
              codeToApply = discountCode2x.trim();
            } else if (currentQty === 3 && discountCode3x) {
              codeToApply = discountCode3x.trim();
            }

            if (codeToApply) {
              fetch(shopifyRoot + 'discount/' + encodeURIComponent(codeToApply))
                .finally(function() {
                  proceedToCheckout(codeToApply);
                });
            } else {
              proceedToCheckout('');
            }
          })
          .catch(function() {
            // Fallback checkout on fail
            submitCheckout(interceptedCheckoutBtn);
          });
        });
        
        // Skip and Proceed
        skipBtn.addEventListener('click', function() {
          modal.classList.remove('active');
          modal.setAttribute('aria-hidden', 'true');
          submitCheckout(interceptedCheckoutBtn);
        });
        
        // Close modal when clicking backdrop
        modal.addEventListener('click', function(event) {
          if (event.target === modal) {
            modal.classList.remove('active');
            modal.setAttribute('aria-hidden', 'true');
            submitCheckout(interceptedCheckoutBtn);
          }
        });
      }
      
      function proceedToCheckout(discountCode) {
        bypassPopup = true;
        if (discountCode) {
          window.location.href = '/checkout?discount=' + encodeURIComponent(discountCode);
        } else {
          submitCheckout(interceptedCheckoutBtn);
        }
      }
      
      function submitCheckout(button) {
        bypassPopup = true;
        if (button && typeof button.click === 'function') {
          button.click();
        } else {
          var fallbackBtn = document.querySelector('#CartDrawer-Checkout') || 
                            document.querySelector('.cart__checkout-button') ||
                            document.querySelector('button[name="checkout"]') || 
                            document.querySelector('input[name="checkout"]');
          if (fallbackBtn && typeof fallbackBtn.click === 'function') {
            fallbackBtn.click();
          } else {
            window.location.href = '/checkout';
          }
        }
      }
      
      // Load event listener
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initUpsellPopup);
      } else {
        initUpsellPopup();
      }
    })();
  </script>
{%- endif -%}

