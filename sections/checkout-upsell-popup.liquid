{%- comment -%}
  Checkout Upsell Popup Section
  Intercepts clicks on the cart drawer's checkout button.
  Shows a high-converting chest harness upsell popup before proceeding.
{%- endcomment -%}

{%- if section.settings.enable -%}
  {%- assign upsell_product = all_products[section.settings.upsell_product] -%}
  {%- if upsell_product == blank -%}
    {%- assign upsell_product = all_products['harness'] -%}
  {%- endif -%}

  {%- assign product_title = section.settings.product_title_override | default: upsell_product.title -%}
  {%- if product_title == blank -%}
    {%- assign product_title = "SafePet Heavy-Duty Chest Harness" -%}
  {%- endif -%}

  {%- assign product_image = upsell_product.featured_image | default: 'a066ed7ecb67a06a034c860220b45268.jpg' -%}

  {%- assign product_price = section.settings.product_price -%}
  {%- if product_price == blank and upsell_product != blank -%}
    {%- assign product_price = upsell_product.price | money -%}
  {%- endif -%}
  {%- if product_price == blank -%}
    {%- assign product_price = "$27.95" -%}
  {%- endif -%}

  {%- assign compare_price = section.settings.product_compare_price -%}
  {%- if compare_price == blank and upsell_product != blank -%}
    {%- assign compare_price = upsell_product.compare_at_price | money -%}
  {%- endif -%}
  {%- if compare_price == blank -%}
    {%- assign compare_price = "$42.99" -%}
  {%- endif -%}

  {%- assign trigger_ids = "" -%}
  {%- if section.settings.trigger_products != blank -%}
    {%- for prod in section.settings.trigger_products -%}
      {%- if forloop.first -%}
        {%- assign trigger_ids = prod.id | append: "" -%}
      {%- else -%}
        {%- assign trigger_ids = trigger_ids | append: "," | append: prod.id -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  <div class="checkout-upsell-modal-overlay" id="checkoutUpsellPopup" aria-hidden="true" role="dialog">
    <div class="checkout-upsell-modal-card">
      
      <!-- Red Urgency Header -->
      {%- if section.settings.heading != blank -%}
        <div class="checkout-upsell-header-banner">
          <span class="checkout-upsell-header-text">{{ section.settings.heading | escape }}</span>
          <span class="checkout-upsell-timer-wrap">
            <span class="checkout-upsell-timer-label">⏰ Reserved for:</span>
            <span class="checkout-upsell-timer-time" id="checkoutUpsellTimer">04:59</span>
          </span>
        </div>
      {%- endif -%}
      
      <div class="checkout-upsell-modal-body">
        <!-- Main Headline -->
        {%- if section.settings.subheading != blank -%}
          <h3 class="checkout-upsell-headline">
            {{ section.settings.subheading | escape }}
          </h3>
        {%- endif -%}
        
        <!-- Collar Warning Box -->
        {%- if section.settings.warning_text != blank -%}
          <div class="checkout-upsell-warning-box">
            {{ section.settings.warning_text | newline_to_br }}
          </div>
        {%- endif -%}
        
        <!-- Product Display Info -->
        <div class="checkout-upsell-product-row">
          <div class="checkout-upsell-product-media">
            {%- if upsell_product != blank and upsell_product.featured_image != blank -%}
              <img src="{{ product_image | image_url: width: 350 }}" alt="{{ product_title }}" class="checkout-upsell-product-img" loading="lazy">
            {%- else -%}
              <img src="{{ 'harness-car-safety-hero.jpg' | asset_url }}" alt="{{ product_title }}" class="checkout-upsell-product-img" loading="lazy">
            {%- endif -%}
          </div>
          
          <div class="checkout-upsell-product-info">
            <h4 class="checkout-upsell-product-title">{{ product_title }}</h4>
            
            <div class="checkout-upsell-price-row">
              <span class="checkout-upsell-price-sale" id="checkoutUpsellDisplayPrice">{{ product_price }}</span>
              <span class="checkout-upsell-price-compare" id="checkoutUpsellDisplayCompare">{{ compare_price }}</span>
              <span class="checkout-upsell-price-discount-pill" id="checkoutUpsellDisplayDiscount">Save 35%</span>
            </div>
          </div>
        </div>

        <!-- Quantity Selection (1x, 2x, 3x) -->
        <!-- Quantity Selection (1x, 2x, 3x — Price Per Unit Highlighted) -->
        <div class="checkout-upsell-qty-wrap">
          <div class="checkout-upsell-qty-header">
            <span class="checkout-upsell-qty-label">1. Choose Quantity:</span>
            <span class="checkout-upsell-savings-hint" id="checkoutUpsellSavingsHint">Standard Single Pack</span>
          </div>
          <div class="checkout-upsell-qty-grid">
            <!-- 1x Harness -->
            <button type="button" class="checkout-upsell-qty-card active" id="checkoutUpsellQty1" data-qty="1">
              <span class="checkout-upsell-qty-check">
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <div class="checkout-upsell-qty-card-row">
                <span class="checkout-upsell-qty-card-title">1x Harness</span>
              </div>
              <div class="checkout-upsell-qty-price-row">
                <span class="checkout-upsell-qty-unit-price" id="checkoutUpsellQty1Price">$24.95</span>
                <span class="checkout-upsell-qty-unit-label">/ea</span>
              </div>
              <div class="checkout-upsell-qty-card-sub">Single Pup</div>
            </button>
            
            <!-- 2x Harnesses -->
            <button type="button" class="checkout-upsell-qty-card" id="checkoutUpsellQty2" data-qty="2">
              <span class="checkout-upsell-qty-badge checkout-upsell-badge-green">POPULAR</span>
              <span class="checkout-upsell-qty-check">
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <div class="checkout-upsell-qty-card-row">
                <span class="checkout-upsell-qty-card-title">2x Harnesses</span>
              </div>
              <div class="checkout-upsell-qty-price-row">
                <span class="checkout-upsell-qty-unit-price text-green" id="checkoutUpsellQty2Price">$22.95</span>
                <span class="checkout-upsell-qty-unit-label text-green">/ea</span>
              </div>
              <div class="checkout-upsell-qty-card-sub text-green">Save $4.00</div>
            </button>

            <!-- 3x Harnesses -->
            <button type="button" class="checkout-upsell-qty-card" id="checkoutUpsellQty3" data-qty="3">
              <span class="checkout-upsell-qty-badge checkout-upsell-badge-green">BEST VALUE</span>
              <span class="checkout-upsell-qty-check">
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <div class="checkout-upsell-qty-card-row">
                <span class="checkout-upsell-qty-card-title">3x Harnesses</span>
              </div>
              <div class="checkout-upsell-qty-price-row">
                <span class="checkout-upsell-qty-unit-price text-green" id="checkoutUpsellQty3Price">$19.95</span>
                <span class="checkout-upsell-qty-unit-label text-green">/ea</span>
              </div>
              <div class="checkout-upsell-qty-card-sub text-green">Save $15.00</div>
            </button>
          </div>
        </div>
        
        <!-- Compact Size Selection Cards (Matching Reference Screenshot S, M, L, XL with Chart Weights) -->
        <div class="checkout-upsell-variants-wrap">
          
          <!-- Harness #1 Section -->
          <div class="checkout-upsell-dog-section" id="checkoutUpsellDog1Wrap">
            <div class="checkout-upsell-variants-header">
              <span class="checkout-upsell-variants-label" id="checkoutUpsellSizeLabel1">
                Select Size: <span class="checkout-upsell-active-size-name" id="selectedSizeText1">S (10–28 Lbs)</span>
              </span>
              <span class="size-chart__integrated-inline">
                <button type="button" class="checkout-upsell-size-chart-trigger" id="checkoutUpsellSizeChartTrigger">
                  Sizing Chart 📏
                </button>
              </span>
            </div>
            
            <div class="size-pills-row" id="checkoutUpsellVariantCards1">
              {%- if upsell_product != blank -%}
                {%- assign active_card_1 = false -%}
                {%- for variant in upsell_product.variants -%}
                  {%- assign title_clean = variant.title | strip | upcase -%}
                  {%- assign prefix_2 = title_clean | slice: 0, 2 -%}
                  {%- assign prefix_1 = title_clean | slice: 0, 1 -%}
                  {%- assign first_word = title_clean | split: ' ' | first -%}
                  {%- assign is_valid_size = false -%}
                  {%- assign display_size = '' -%}
                  {%- assign weight_str = '' -%}

                  {%- if prefix_2 == 'XS' or first_word == 'XS' or title_clean contains 'EXTRA SMALL' -%}
                    {%- assign is_valid_size = false -%}
                  {%- elsif prefix_2 == 'XL' or prefix_1 == 'X' or first_word == 'XL' or first_word == 'X-LARGE' or title_clean contains 'EXTRA LARGE' -%}
                    {%- assign is_valid_size = true -%}
                    {%- assign display_size = 'XL' -%}
                    {%- assign weight_str = '70–132 Lbs' -%}
                  {%- elsif prefix_1 == 'S' or first_word == 'S' or first_word == 'SMALL' -%}
                    {%- assign is_valid_size = true -%}
                    {%- assign display_size = 'S' -%}
                    {%- assign weight_str = '10–28 Lbs' -%}
                  {%- elsif prefix_1 == 'M' or first_word == 'M' or first_word == 'MEDIUM' -%}
                    {%- assign is_valid_size = true -%}
                    {%- assign display_size = 'M' -%}
                    {%- assign weight_str = '28–50 Lbs' -%}
                  {%- elsif prefix_1 == 'L' or first_word == 'L' or first_word == 'LARGE' -%}
                    {%- assign is_valid_size = true -%}
                    {%- assign display_size = 'L' -%}
                    {%- assign weight_str = '45–70 Lbs' -%}
                  {%- endif -%}

                  {%- if is_valid_size -%}
                    {%- assign is_active1 = false -%}
                    {%- if display_size == 'S' and active_card_1 == false -%}
                      {%- assign is_active1 = true -%}
                      {%- assign active_card_1 = true -%}
                    {%- endif -%}
                    <div class="size-pill-card{% if is_active1 %} active{% endif %}" 
                         data-dog="1"
                         data-variant-id="{{ variant.id }}"
                         data-size="{{ display_size }}"
                         data-weight="{{ weight_str }}">
                      <div class="size-pill-top">
                        <span class="size-check-badge">
                          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                        </span>
                        <span class="size-letter">{{ display_size }}</span>
                      </div>
                      <div class="size-weight">{{ weight_str }}</div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                <div class="size-pill-card active" data-dog="1" data-variant-id="48139846418662" data-size="S" data-weight="10–28 Lbs">
                  <div class="size-pill-top">
                    <span class="size-check-badge">
                      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </span>
                    <span class="size-letter">S</span>
                  </div>
                  <div class="size-weight">10–28 Lbs</div>
                </div>
                <div class="size-pill-card" data-dog="1" data-variant-id="48139846484198" data-size="M" data-weight="28–50 Lbs">
                  <div class="size-pill-top">
                    <span class="size-check-badge">
                      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </span>
                    <span class="size-letter">M</span>
                  </div>
                  <div class="size-weight">28–50 Lbs</div>
                </div>
                <div class="size-pill-card" data-dog="1" data-variant-id="48139846516966" data-size="L" data-weight="45–70 Lbs">
                  <div class="size-pill-top">
                    <span class="size-check-badge">
                      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </span>
                    <span class="size-letter">L</span>
                  </div>
                  <div class="size-weight">45–70 Lbs</div>
                </div>
                <div class="size-pill-card" data-dog="1" data-variant-id="48139846549734" data-size="XL" data-weight="70–132 Lbs">
                  <div class="size-pill-top">
                    <span class="size-check-badge">
                      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </span>
                    <span class="size-letter">XL</span>
                  </div>
                  <div class="size-weight">70–132 Lbs</div>
                </div>
              {%- endif -%}
            </div>
          </div>

          <!-- Dog 2 Size Selector (Expands dynamically when 2x or 3x is chosen) -->
          <div class="checkout-upsell-dog-section checkout-upsell-dog-expand" id="checkoutUpsellDog2Wrap" style="display: none;">
            <div class="checkout-upsell-variants-header checkout-upsell-dog-header">
              <span class="checkout-upsell-variants-label">
                🐶 Harness #2 Size: <span class="checkout-upsell-active-size-name" id="selectedSizeText2">M (28–50 Lbs)</span>
              </span>
              <span class="checkout-upsell-dog-hint">Mix & match any size</span>
            </div>
            
            <div class="size-pills-row" id="checkoutUpsellVariantCards2">
              {%- if upsell_product != blank -%}
                {%- assign active_card_2 = false -%}
                {%- for variant in upsell_product.variants -%}
                  {%- assign title_clean = variant.title | strip | upcase -%}
                  {%- assign prefix_2 = title_clean | slice: 0, 2 -%}
                  {%- assign prefix_1 = title_clean | slice: 0, 1 -%}
                  {%- assign first_word = title_clean | split: ' ' | first -%}
                  {%- assign is_valid_size = false -%}
                  {%- assign display_size = '' -%}
                  {%- assign weight_str = '' -%}

                  {%- if prefix_2 == 'XS' or first_word == 'XS' or title_clean contains 'EXTRA SMALL' -%}
                    {%- assign is_valid_size = false -%}
                  {%- elsif prefix_2 == 'XL' or prefix_1 == 'X' or first_word == 'XL' or first_word == 'X-LARGE' or title_clean contains 'EXTRA LARGE' -%}
                    {%- assign is_valid_size = true -%}
                    {%- assign display_size = 'XL' -%}
                    {%- assign weight_str = '70–132 Lbs' -%}
                  {%- elsif prefix_1 == 'S' or first_word == 'S' or first_word == 'SMALL' -%}
                    {%- assign is_valid_size = true -%}
                    {%- assign display_size = 'S' -%}
                    {%- assign weight_str = '10–28 Lbs' -%}
                  {%- elsif prefix_1 == 'M' or first_word == 'M' or first_word == 'MEDIUM' -%}
                    {%- assign is_valid_size = true -%}
                    {%- assign display_size = 'M' -%}
                    {%- assign weight_str = '28–50 Lbs' -%}
                  {%- elsif prefix_1 == 'L' or first_word == 'L' or first_word == 'LARGE' -%}
                    {%- assign is_valid_size = true -%}
                    {%- assign display_size = 'L' -%}
                    {%- assign weight_str = '45–70 Lbs' -%}
                  {%- endif -%}

                  {%- if is_valid_size -%}
                    {%- assign is_active2 = false -%}
                    {%- if display_size == 'M' and active_card_2 == false -%}
                      {%- assign is_active2 = true -%}
                      {%- assign active_card_2 = true -%}
                    {%- endif -%}
                    <div class="size-pill-card{% if is_active2 %} active{% endif %}" 
                         data-dog="2"
                         data-variant-id="{{ variant.id }}"
                         data-size="{{ display_size }}"
                         data-weight="{{ weight_str }}">
                      <div class="size-pill-top">
                        <span class="size-check-badge">
                          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                        </span>
                        <span class="size-letter">{{ display_size }}</span>
                      </div>
                      <div class="size-weight">{{ weight_str }}</div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                <div class="size-pill-card" data-dog="2" data-variant-id="48139846418662" data-size="S" data-weight="10–28 Lbs">
                  <div class="size-pill-top">
                    <span class="size-check-badge"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                    <span class="size-letter">S</span>
                  </div>
                  <div class="size-weight">10–28 Lbs</div>
                </div>
                <div class="size-pill-card active" data-dog="2" data-variant-id="48139846484198" data-size="M" data-weight="28–50 Lbs">
                  <div class="size-pill-top">
                    <span class="size-check-badge"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                    <span class="size-letter">M</span>
                  </div>
                  <div class="size-weight">28–50 Lbs</div>
                </div>
                <div class="size-pill-card" data-dog="2" data-variant-id="48139846516966" data-size="L" data-weight="45–70 Lbs">
                  <div class="size-pill-top">
                    <span class="size-check-badge"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                    <span class="size-letter">L</span>
                  </div>
                  <div class="size-weight">45–70 Lbs</div>
                </div>
                <div class="size-pill-card" data-dog="2" data-variant-id="48139846549734" data-size="XL" data-weight="70–132 Lbs">
                  <div class="size-pill-top">
                    <span class="size-check-badge"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                    <span class="size-letter">XL</span>
                  </div>
                  <div class="size-weight">70–132 Lbs</div>
                </div>
              {%- endif -%}
            </div>
          </div>

          <!-- Dog 3 Size Selector (Expands dynamically when 3x is chosen) -->
          <div class="checkout-upsell-dog-section checkout-upsell-dog-expand" id="checkoutUpsellDog3Wrap" style="display: none;">
            <div class="checkout-upsell-variants-header checkout-upsell-dog-header">
              <span class="checkout-upsell-variants-label">
                🐶 Harness #3 Size: <span class="checkout-upsell-active-size-name" id="selectedSizeText3">L (45–70 Lbs)</span>
              </span>
              <span class="checkout-upsell-dog-hint">Mix & match any size</span>
            </div>
            
            <div class="size-pills-row" id="checkoutUpsellVariantCards3">
              {%- if upsell_product != blank -%}
                {%- assign active_card_3 = false -%}
                {%- for variant in upsell_product.variants -%}
