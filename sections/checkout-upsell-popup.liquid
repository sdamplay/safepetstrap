                  {%- assign prefix_2 = title_clean | slice: 0, 2 -%}
                  {%- assign prefix_1 = title_clean | slice: 0, 1 -%}
                  {%- assign first_word = title_clean | split: ' ' | first -%}
                  {%- assign is_valid_size = false -%}
                  {%- assign display_size = '' -%}
                  {%- assign weight_str = '' -%}

                  {%- if prefix_2 == 'XS' or first_word == 'XS' or title_clean contains 'EXTRA SMALL' -%}
                    {%- assign is_valid_size = false -%}
                  {%- elsif prefix_2 == 'XL' or prefix_1 == 'X' or first_word == 'XL' or first_word == 'X-LARGE' or title_clean contains 'EXTRA LARGE' -%}
                    {%- assign is_valid_size = true -%}
                    {%- assign display_size = 'XL' -%}
                    {%- assign weight_str = '70–132 Lbs' -%}
                  {%- elsif prefix_1 == 'S' or first_word == 'S' or first_word == 'SMALL' -%}
                    {%- assign is_valid_size = true -%}
                    {%- assign display_size = 'S' -%}
                    {%- assign weight_str = '10–28 Lbs' -%}
                  {%- elsif prefix_1 == 'M' or first_word == 'M' or first_word == 'MEDIUM' -%}
                    {%- assign is_valid_size = true -%}
                    {%- assign display_size = 'M' -%}
                    {%- assign weight_str = '28–50 Lbs' -%}
                  {%- elsif prefix_1 == 'L' or first_word == 'L' or first_word == 'LARGE' -%}
                    {%- assign is_valid_size = true -%}
                    {%- assign display_size = 'L' -%}
                    {%- assign weight_str = '45–70 Lbs' -%}
                  {%- endif -%}

                  {%- if is_valid_size -%}
                    {%- assign is_active3 = false -%}
                    {%- if display_size == 'L' and active_card_3 == false -%}
                      {%- assign is_active3 = true -%}
                      {%- assign active_card_3 = true -%}
                    {%- endif -%}
                    <div class="size-pill-card{% if is_active3 %} active{% endif %}" 
                         data-dog="3"
                         data-variant-id="{{ variant.id }}"
                         data-size="{{ display_size }}"
                         data-weight="{{ weight_str }}">
                      <div class="size-pill-top">
                        <span class="size-check-badge">
                          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                        </span>
                        <span class="size-letter">{{ display_size }}</span>
                      </div>
                      <div class="size-weight">{{ weight_str }}</div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                <div class="size-pill-card" data-dog="3" data-variant-id="48139846418662" data-size="S" data-weight="10–28 Lbs">
                  <div class="size-pill-top">
                    <span class="size-check-badge"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                    <span class="size-letter">S</span>
                  </div>
                  <div class="size-weight">10–28 Lbs</div>
                </div>
                <div class="size-pill-card" data-dog="3" data-variant-id="48139846484198" data-size="M" data-weight="28–50 Lbs">
                  <div class="size-pill-top">
                    <span class="size-check-badge"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                    <span class="size-letter">M</span>
                  </div>
