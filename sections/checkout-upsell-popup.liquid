    },
    {
      "type": "header",
      "content": "Heading Banner Text Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading banner text",
      "default": "🚨 WAIT! COMPLETE YOUR PUP'S CAR SAFETY & SAVE 35%"
    },
    {
      "type": "range",
      "id": "font_size_banner",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Banner Font Size",
      "default": 13
    },
    {
      "type": "header",
      "content": "Main Headline Text Settings"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Main Headline text",
      "default": "Never Attach a Car Seat Belt Directly to Your Dog's Collar..."
    },
    {
      "type": "range",
      "id": "font_size_headline",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Headline Font Size",
      "default": 19
    },
    {
      "type": "header",
