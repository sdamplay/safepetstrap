      background-color: rgba(17, 24, 39, 0.85);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 10000000;
      display: flex;
      justify-content: center;
      align-items: center;
      opacity: 0;
