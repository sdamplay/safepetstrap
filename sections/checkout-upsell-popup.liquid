{%- comment -%}
  Checkout Upsell Popup Section
  Intercepts clicks on the cart drawer's checkout button.
  Shows a high-converting chest harness upsell popup before proceeding.
{%- endcomment -%}

{%- if section.settings.enable -%}
  {%- assign upsell_product = all_products[section.settings.upsell_product] -%}
  {%- if upsell_product == blank -%}
    {%- assign upsell_product = all_products['harness'] -%}
  {%- endif -%}

  {%- assign product_title = section.settings.product_title_override | default: upsell_product.title -%}
  {%- if product_title == blank -%}
    {%- assign product_title = "SafePet Heavy-Duty Chest Harness" -%}
  {%- endif -%}

  {%- assign product_image = upsell_product.featured_image | default: 'a066ed7ecb67a06a034c860220b45268.jpg' -%}

  {%- assign product_price = section.settings.product_price -%}
  {%- if product_price == blank and upsell_product != blank -%}
    {%- assign product_price = upsell_product.price | money -%}
  {%- endif -%}
  {%- if product_price == blank -%}
    {%- assign product_price = "$27.95" -%}
  {%- endif -%}

  {%- assign compare_price = section.settings.product_compare_price -%}
  {%- if compare_price == blank and upsell_product != blank -%}
    {%- assign compare_price = upsell_product.compare_at_price | money -%}
  {%- endif -%}
  {%- if compare_price == blank -%}
    {%- assign compare_price = "$42.99" -%}
  {%- endif -%}

  {%- assign trigger_ids = "" -%}
  {%- if section.settings.trigger_products != blank -%}
    {%- for prod in section.settings.trigger_products -%}
      {%- if forloop.first -%}
        {%- assign trigger_ids = prod.id | append: "" -%}
      {%- else -%}
        {%- assign trigger_ids = trigger_ids | append: "," | append: prod.id -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  <div class="checkout-upsell-modal-overlay" id="checkoutUpsellPopup" aria-hidden="true" role="dialog">
    <div class="checkout-upsell-modal-card">
      
      <!-- Red Urgency Header -->
      {%- if section.settings.heading != blank -%}
        <div class="checkout-upsell-header-banner">
          {{ section.settings.heading | escape }}
        </div>
      {%- endif -%}
      
      <div class="checkout-upsell-modal-body">
        <!-- Main Headline -->
        {%- if section.settings.subheading != blank -%}
          <h3 class="checkout-upsell-headline">
            {{ section.settings.subheading | escape }}
          </h3>
        {%- endif -%}
        
        <!-- Collar Warning Box -->
        {%- if section.settings.warning_text != blank -%}
          <div class="checkout-upsell-warning-box">
            {{ section.settings.warning_text | newline_to_br }}
          </div>
        {%- endif -%}
        
        <!-- Product Display Info -->
        <div class="checkout-upsell-product-row">
          <div class="checkout-upsell-product-media">
            {%- if upsell_product != blank -%}
              <img src="{{ product_image | image_url: width: 300 }}" alt="{{ product_title }}" class="checkout-upsell-product-img" loading="lazy">
            {%- else -%}
              <img src="https://cdn.shopify.com/s/files/1/0817/3469/7190/files/a066ed7ecb67a06a034c860220b45268.jpg?v=1786263205" alt="{{ product_title }}" class="checkout-upsell-product-img" loading="lazy">
            {%- endif -%}
          </div>
          
          <div class="checkout-upsell-product-info">
            <h4 class="checkout-upsell-product-title">{{ product_title }}</h4>
            
            <div class="checkout-upsell-price-row">
              <span class="checkout-upsell-price-sale">{{ product_price }}</span>
              <span class="checkout-upsell-price-compare">{{ compare_price }}</span>
              <span class="checkout-upsell-price-discount-pill">Save 35%</span>
            </div>
          </div>
        </div>
        
        <!-- Variant / Size Selection (Moved above benefits bullets for mobile viewability) -->
        <div class="checkout-upsell-variants-wrap">
          <div class="checkout-upsell-variants-header">
            <span class="checkout-upsell-variants-label">Select Your Dog's Size:</span>
            <span class="size-chart__integrated-inline">
              <button type="button" class="checkout-upsell-size-chart-trigger" id="checkoutUpsellSizeChartTrigger">
                📏 View Sizing Table
              </button>
            </span>
          </div>
          
          <!-- Size Chart Popup Modal -->
          <div class="checkout-upsell-size-popup-overlay" id="checkoutUpsellSizePopup" aria-hidden="true" role="dialog">
            <div class="checkout-upsell-size-popup-card">
              <button type="button" class="checkout-upsell-size-popup-close" id="checkoutUpsellSizePopupClose" aria-label="Close Size Chart">×</button>
              <div class="checkout-upsell-size-popup-body">
                {%- if section.settings.size_chart_image != blank -%}
                  <img src="{{ section.settings.size_chart_image | image_url: width: 800 }}" alt="Harness Size Chart" loading="lazy">
                {%- else -%}
                  <img src="{{ 'harness-size-chart.jpg' | asset_url }}" alt="Harness Size Chart" loading="lazy">
                {%- endif -%}
              </div>
            </div>
          </div>
          
          <div class="checkout-upsell-pills-row" id="checkoutUpsellVariantPills">
            {%- if upsell_product != blank -%}
              {%- assign active_set = false -%}
              {%- for variant in upsell_product.variants -%}
                {%- assign title_upper = variant.title | upcase -%}
                {%- if title_upper != 'XS' -%}
                  <button type="button" 
                          class="checkout-upsell-size-pill{% if active_set == false %} active{% endif %}" 
                          data-variant-id="{{ variant.id }}">
                    {{ variant.title }}
                  </button>
                  {%- assign active_set = true -%}
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <button type="button" class="checkout-upsell-size-pill active" data-variant-id="48139846418662">S</button>
              <button type="button" class="checkout-upsell-size-pill" data-variant-id="48139846484198">M</button>
              <button type="button" class="checkout-upsell-size-pill" data-variant-id="48139846516966">L</button>
              <button type="button" class="checkout-upsell-size-pill" data-variant-id="48139846549734">XL</button>
            {%- endif -%}
          </div>
        </div>

        <!-- Benefits bullets (Moved below variants selector) -->
        {%- if section.settings.benefits != blank -%}
          <ul class="checkout-upsell-bullets">
            {%- assign bullets = section.settings.benefits | split: "\n" -%}
            {%- for bullet in bullets -%}
              {%- if bullet != blank -%}
                <li>{{ bullet | strip }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      
      <!-- Actions Footer -->
      <div class="checkout-upsell-modal-footer">
        <button type="button" class="checkout-upsell-add-btn" id="checkoutUpsellAddBtn">
          <span>{{ section.settings.add_btn_text | escape }}</span>
          {%- if section.settings.add_btn_subtext != blank -%}
            <span class="checkout-upsell-add-btn-subtext">
              {{ section.settings.add_btn_subtext | escape }}
            </span>
          {%- endif -%}
        </button>
        <button type="button" class="checkout-upsell-skip-btn" id="checkoutUpsellSkipBtn">
          {{ section.settings.skip_btn_text | escape }}
        </button>
      </div>
      
    </div>
  </div>

  <style>
    /* Modal Overlay styling */
    .checkout-upsell-modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(17, 24, 39, 0.75);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 999999;
      display: flex;
      justify-content: center;
      align-items: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }
    .checkout-upsell-modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }
    
    /* Modal Card styling */
    .checkout-upsell-modal-card {
      background-color: #ffffff;
      width: 92%;
      max-width: 550px;
      border-radius: 16px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 10px 10px -5px rgba(0, 0, 0, 0.05);
      overflow: hidden;
      transform: scale(0.9);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      border: 1px solid rgba(229, 231, 235, 0.5);
      font-family: inherit;
    }
    .checkout-upsell-modal-overlay.active .checkout-upsell-modal-card {
      transform: scale(1);
    }
    
    /* Danger/Urgency Header */
    .checkout-upsell-header-banner {
      background-color: #dc2626;
      color: #ffffff;
      text-align: center;
      padding: 12px 16px;
      font-size: {{ section.settings.font_size_banner }}px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    
    /* Content container */
    .checkout-upsell-modal-body {
      padding: 10px;
      overflow-y: auto;
      flex-grow: 1;
      text-align: left;
    }
    
    /* Main Headline */
    .checkout-upsell-headline {
      color: #111827;
      font-size: {{ section.settings.font_size_headline }}px;
      font-weight: 800;
      line-height: 1.35;
      margin: 0 0 6px 0;
      text-align: center;
      letter-spacing: -0.02em;
    }
    
    .checkout-upsell-subheading {
      color: #4b5563;
      font-size: 13.5px;
      font-weight: 500;
      line-height: 1.4;
      margin: 0 0 16px 0;
      text-align: center;
    }
    
    /* Collar Danger Warning Box */
    .checkout-upsell-warning-box {
      background-color: #fef2f2;
      border: 1px solid #fee2e2;
      border-left: 4px solid #ef4444;
      border-radius: 8px;
      padding: 12px 14px;
      font-size: {{ section.settings.font_size_warning }}px;
      line-height: 1.45;
      color: #991b1b;
      margin-bottom: 20px;
    }
    .checkout-upsell-warning-box p {
      margin: 0;
    }
    
    /* Product Block */
    .checkout-upsell-product-row {
      display: flex;
      gap: 18px;
      margin-bottom: 0 !important;
    }
    @media screen and (max-width: 480px) {
      .checkout-upsell-product-row {
        flex-direction: column;
        gap: 12px;
        align-items: center;
        text-align: center;
      }
    }
    
    .checkout-upsell-product-media {
      width: {{ section.settings.image_size }}px;
      height: {{ section.settings.image_size }}px;
      flex-shrink: 0;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid #e5e7eb;
      background-color: #f9fafb;
    }
    .checkout-upsell-product-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    
    .checkout-upsell-product-info {
      flex-grow: 1;
    }
    
    .checkout-upsell-product-title {
      color: #111827;
      font-size: {{ section.settings.font_size_title }}px;
      font-weight: 750;
      margin: 0 0 6px 0;
      line-height: 1.3;
    }
    
    /* Pricing */
    .checkout-upsell-price-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 10px;
    }
    @media screen and (max-width: 480px) {
      .checkout-upsell-price-row {
        justify-content: center;
      }
    }
    .checkout-upsell-price-sale {
      color: #dc2626;
      font-size: {{ section.settings.font_size_price }}px;
      font-weight: 800;
    }
    .checkout-upsell-price-compare {
      color: #9ca3af;
      font-size: {{ section.settings.font_size_compare }}px;
      text-decoration: line-through;
    }
    .checkout-upsell-price-discount-pill {
      background-color: #dcfce7;
      color: #15803d;
      font-size: 11.5px;
      font-weight: 700;
      padding: 1px 8px;
      border-radius: 9999px;
      text-transform: uppercase;
    }
    
    /* Bullet Points */
    .checkout-upsell-bullets {
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: {{ section.settings.font_size_bullets }}px;
      color: #4b5563;
      line-height: 1.5;
    }
    .checkout-upsell-bullets li {
      margin-bottom: 5px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    @media screen and (max-width: 480px) {
      .checkout-upsell-bullets li {
        justify-content: center;
      }
    }
    .checkout-upsell-bullets li::before {
      content: "✓";
      color: #16a34a;
      font-weight: bold;
    }
    
    /* Variant Selection */
    .checkout-upsell-variants-wrap {
      margin-bottom: 8px;
    }
    .checkout-upsell-variants-label {
      font-size: 13px;
      font-weight: 750;
      color: #374151;
      margin-bottom: 8px;
      display: block;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }
    .checkout-upsell-pills-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
    }
    .checkout-upsell-size-pill {
      background-color: #ffffff;
      border: 2px solid #e5e7eb;
      color: #111827;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 13.5px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
      outline: none;
    }
    .checkout-upsell-size-pill:hover {
      border-color: #9ca3af;
    }
    .checkout-upsell-size-pill.active {
      border-color: #dc2626;
      background-color: #fef2f2;
      color: #dc2626;
    }
    
    /* Size Guide Toggle */
    .checkout-upsell-size-guide-toggle {
      display: block;
      text-align: center;
      font-size: 11.5px;
      color: #dc2626;
      text-decoration: underline;
      margin-top: 10px;
      cursor: pointer;
      font-weight: 600;
    }
    
    /* Size Guide Table */
    .checkout-upsell-size-guide-table {
      display: none;
      width: 100%;
      margin-top: 12px;
      border-collapse: collapse;
      font-size: 11px;
      border: 1px solid #e5e7eb;
      box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      border-radius: 6px;
      overflow: hidden;
    }
    .checkout-upsell-size-guide-table.active {
      display: table;
    }
    .checkout-upsell-size-guide-table th, 
    .checkout-upsell-size-guide-table td {
      padding: 6px 8px;
      border: 1px solid #e5e7eb;
      text-align: center;
    }
    .checkout-upsell-size-guide-table th {
      background-color: #f9fafb;
      color: #374151;
      font-weight: bold;
    }    /* Actions/Footer */
    .checkout-upsell-modal-footer {
      padding: 12px;
      border-top: 1px solid #f3f4f6;
      display: flex;
      flex-direction: row;
      gap: 10px;
      align-items: center;
      justify-content: center;
      background-color: #ffffff;
    }
    
    .checkout-upsell-add-btn {
      flex: 1.5;
      background-color: #dc2626;
      color: #ffffff;
      border: none;
      border-radius: 25px !important;
      padding: 12px 16px;
      font-size: {{ section.settings.font_size_add_btn }}px;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 4px 6px -1px rgba(220, 38, 38, 0.35);
      transition: all 0.2s ease;
      animation: checkout-upsell-pulse 2s infinite;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      line-height: 1.25;
      min-height: 50px;
    }
    .checkout-upsell-add-btn:hover {
      background-color: #b91c1c;
      box-shadow: 0 6px 8px -1px rgba(220, 38, 38, 0.45);
    }
    
    .checkout-upsell-add-btn-subtext {
      font-size: 10px;
      color: rgba(255, 255, 255, 0.95);
      font-weight: 600;
      margin-top: 2px;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      display: block;
    }
    
    .checkout-upsell-skip-btn {
      flex: 1;
      background: #ffffff;
      border: 1.5px solid rgb(38, 38, 38);
      border-radius: 25px !important;
      color: rgb(38, 38, 38);
      font-size: {{ section.settings.font_size_skip_btn }}px;
      font-weight: 700;
      text-decoration: none !important;
      padding: 12px 16px;
      cursor: pointer;
      transition: all 0.2s ease;
      outline: none;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1.25;
      min-height: 50px;
      margin-top: 0 !important;
    }
    .checkout-upsell-skip-btn:hover {
      background-color: #f9fafb;
      color: #111827;
      border-color: #111827;
    }
    
    @media screen and (max-width: 480px) {
      .checkout-upsell-modal-overlay {
        align-items: flex-start !important;
        padding-top: 15px !important;
      }
      .checkout-upsell-modal-card {
        max-height: 95vh !important;
        margin: 0 auto;
      }
      .checkout-upsell-modal-footer {
        padding: 8px !important;
        gap: 6px !important;
      }
      .checkout-upsell-add-btn,
      .checkout-upsell-skip-btn {
        padding: 8px 10px !important;
        min-height: 44px !important;
        font-size: 13px !important;
      }
      .checkout-upsell-add-btn-subtext {
        font-size: 9px !important;
      }
    }
    }
    
    /* Size Chart Popup Modal styling */
    .checkout-upsell-size-popup-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(17, 24, 39, 0.85);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 10000000;
      display: flex;
      justify-content: center;
      align-items: center;
      opacity: 0;
      visibility: hidden; /* Hidden by default */
      pointer-events: none;
      transition: opacity 0.25s ease, visibility 0.25s ease;
    }
    .checkout-upsell-size-popup-overlay.active {
      opacity: 1;
      visibility: visible; /* Visible only when active */
      pointer-events: auto;
    }
    .checkout-upsell-size-popup-card {
      background-color: #ffffff;
      width: 90%;
      max-width: 480px;
      border-radius: 12px;
      overflow: hidden;
      position: relative;
      transform: scale(0.95);
      transition: transform 0.25s ease;
    }
    .checkout-upsell-size-popup-overlay.active .checkout-upsell-size-popup-card {
      transform: scale(1);
    }
    .checkout-upsell-size-popup-close {
      position: absolute;
      top: 8px;
      right: 12px;
      font-size: 26px;
      font-weight: 300;
      color: #9ca3af;
      cursor: pointer;
      background: none;
      border: none;
      padding: 0;
      line-height: 1;
      z-index: 10;
      transition: color 0.15s ease;
    }
    .checkout-upsell-size-popup-close:hover {
      color: #374151;
    }
    .checkout-upsell-size-popup-body {
      padding: 10px;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .checkout-upsell-size-popup-body img {
      max-width: 100%;
      height: auto;
      border-radius: 6px;
      display: block;
    }
    .checkout-upsell-size-chart-trigger {
      font-size: 12px;
      font-weight: 700;
      color: #dc2626;
      cursor: pointer;
      background: none;
      border: none;
      text-decoration: underline;
      padding: 0;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .checkout-upsell-variants-header {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }
    .checkout-upsell-variants-header .checkout-upsell-variants-label {
      margin-bottom: 0 !important;
      text-transform: uppercase;
      font-size: 13px;
      font-weight: 750;
      color: #374151;
    }
    .size-chart__integrated-inline {
      display: inline-block;
    }
  </style>

  <script>
    (function() {
      // Config data attributes fallback
      var upsellProductId = {{ upsell_product.id | default: 9810334613734 }};
      var triggerProductIds = [{% if trigger_ids != blank %}{{ trigger_ids }}{% endif %}];
      
      var activeVariantId = null;
      var interceptedCheckoutBtn = null;
      var bypassPopup = false;
      
      function initUpsellPopup() {
        var modal = document.getElementById('checkoutUpsellPopup');
        var addBtn = document.getElementById('checkoutUpsellAddBtn');
        var skipBtn = document.getElementById('checkoutUpsellSkipBtn');
        var pillsContainer = document.getElementById('checkoutUpsellVariantPills');
        
        if (!modal) return;
        
        // Initialize default active variant ID
        var activePill = pillsContainer.querySelector('.checkout-upsell-size-pill.active');
        if (activePill) {
          activeVariantId = activePill.getAttribute('data-variant-id');
        }
        
        // Size pills click selection
        pillsContainer.addEventListener('click', function(event) {
          var pill = event.target.closest('.checkout-upsell-size-pill');
          if (pill) {
            pillsContainer.querySelectorAll('.checkout-upsell-size-pill').forEach(function(p) {
              p.classList.remove('active');
            });
            pill.classList.add('active');
            activeVariantId = pill.getAttribute('data-variant-id');
          }
        });
        


        // Sizing Modal Popup Toggle Events
        var sizeChartTrigger = document.getElementById('checkoutUpsellSizeChartTrigger');
        var sizePopup = document.getElementById('checkoutUpsellSizePopup');
        var sizePopupClose = document.getElementById('checkoutUpsellSizePopupClose');
        
        if (sizeChartTrigger && sizePopup) {
          sizeChartTrigger.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            sizePopup.classList.add('active');
            sizePopup.setAttribute('aria-hidden', 'false');
          });
        }
        if (sizePopupClose && sizePopup) {
          sizePopupClose.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            sizePopup.classList.remove('active');
            sizePopup.setAttribute('aria-hidden', 'true');
          });
        }
        if (sizePopup) {
          sizePopup.addEventListener('click', function(e) {
            if (e.target === sizePopup) {
              sizePopup.classList.remove('active');
              sizePopup.setAttribute('aria-hidden', 'true');
            }
          });
        }
        
        // Intercept Checkout Click
        document.addEventListener('click', function(event) {
          if (bypassPopup) return;
          
          var checkoutBtn = event.target.closest('#CartDrawer-Checkout') || 
                            event.target.closest('.cart__checkout-button') ||
                            (event.target.closest('button[name="checkout"]') || event.target.closest('input[name="checkout"]'));
          if (checkoutBtn) {
            // Check if cart already has the upsell product
            event.preventDefault();
            event.stopPropagation();
            
            interceptedCheckoutBtn = checkoutBtn;
            
            fetch(window.Shopify.routes.root + 'cart.js')
              .then(function(res) { return res.json(); })
              .then(function(cart) {
                var hasHarness = cart.items.some(function(item) {
                  return item.product_id === upsellProductId;
                });
                
                // Check if trigger product list is empty, or if at least one trigger product is in the cart
                var hasTriggerProduct = triggerProductIds.length === 0 || cart.items.some(function(item) {
                  return triggerProductIds.indexOf(item.product_id) !== -1;
                });
                
                if (hasHarness || !hasTriggerProduct || cart.item_count === 0) {
                  // Direct checkout
                  submitCheckout(checkoutBtn);
                } else {
                  // Open modal
                  modal.classList.add('active');
                  modal.setAttribute('aria-hidden', 'false');
                }
              })
              .catch(function() {
                // Fallback direct checkout
                submitCheckout(checkoutBtn);
              });
          }
        }, true); // Use capture phase to intercept before theme scripts!
        
        // Add to Order & Checkout
        addBtn.addEventListener('click', function() {
          if (!activeVariantId) return;
          
          addBtn.disabled = true;
          addBtn.innerHTML = '<span class="checkout-upsell-spinner"></span> ADDING TO ORDER...';
          
          var data = {
            id: activeVariantId,
            quantity: 1
          };
          
          fetch(window.Shopify.routes.root + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          })
          .then(function(res) { return res.json(); })
          .then(function() {
            setTimeout(function() {
              submitCheckout(interceptedCheckoutBtn);
            }, 100);
          })
          .catch(function() {
            // Fallback checkout on fail
            submitCheckout(interceptedCheckoutBtn);
          });
        });
        
        // Skip and Proceed
        skipBtn.addEventListener('click', function() {
          modal.classList.remove('active');
          modal.setAttribute('aria-hidden', 'true');
          submitCheckout(interceptedCheckoutBtn);
        });
        
        // Close modal when clicking backdrop
        modal.addEventListener('click', function(event) {
          if (event.target === modal) {
            modal.classList.remove('active');
            modal.setAttribute('aria-hidden', 'true');
            submitCheckout(interceptedCheckoutBtn);
          }
        });
      }
      
      function submitCheckout(button) {
        bypassPopup = true;
        if (button && typeof button.click === 'function') {
          button.click();
        } else {
          var fallbackBtn = document.querySelector('#CartDrawer-Checkout') || 
                            document.querySelector('.cart__checkout-button') ||
                            document.querySelector('button[name="checkout"]') || 
                            document.querySelector('input[name="checkout"]');
          if (fallbackBtn && typeof fallbackBtn.click === 'function') {
            fallbackBtn.click();
          } else {
            window.location.href = '/checkout';
          }
        }
      }
      
      // Load event listener
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initUpsellPopup);
      } else {
        initUpsellPopup();
      }
    })();
  </script>
{%- endif -%}

