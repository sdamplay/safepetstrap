{%- style -%}
  #home-about-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
  }

  .home-about-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .home-about-image-wrap {
    width: 100%;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow-brand-resting);
  }

  .home-about-image-wrap img,
  .home-about-image-wrap svg {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 4/3;
  }

  .home-about-image-wrap svg.placeholder-svg {
    background-color: var(--color-brand-bg-soft-secondary);
    fill: var(--color-brand-primary);
  }

  .home-about-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .home-about-badge {
    display: inline-block;
    padding: 6px 14px;
    background-color: var(--color-brand-bg-soft-secondary);
    color: var(--color-brand-primary-hover);
    font-size: 13px;
    font-weight: 700;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 16px;
  }

  .home-about-title {
    font-family: var(--font-heading-family);
    font-size: 36px;
    font-weight: 700;
    color: var(--color-brand-text-primary);
    margin: 0;
    line-height: 1.2;
  }

  .home-about-title em {
    color: var(--color-brand-primary-hover);
    font-style: normal;
  }

  .home-about-text {
    font-family: var(--font-body-family);
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-brand-text-secondary);
    margin: 0;
  }

  .home-about-text p {
    margin: 0 0 16px 0;
  }

  .home-about-text p:last-child {
    margin-bottom: 0;
  }

  /* Benefit Row Styles */
  .home-about-benefits {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    width: 100%;
    margin-top: 16px;
    border-top: 1px solid var(--color-brand-border);
    padding-top: 24px;
  }

  .home-about-benefit-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
  }

  .home-about-benefit-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background-color: var(--color-brand-bg-soft);
    color: var(--color-brand-primary-hover);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .home-about-benefit-icon-wrap svg {
    width: 24px;
    height: 24px;
    stroke: var(--color-brand-primary-hover);
  }

  .home-about-benefit-text {
    font-family: var(--font-body-family);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-brand-text-primary);
  }

  .home-about-disclosure-line {
    font-family: var(--font-body-family);
    font-size: 12px;
    color: var(--color-brand-text-secondary);
    width: 100%;
    margin-top: 8px;
  }

  .home-about-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-brand-primary-hover);
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    padding: 14px 32px;
    border-radius: 999px;
    box-shadow: var(--shadow-brand-cta);
    transition: background-color 0.2s ease, transform 0.1s ease;
    cursor: pointer;
    border: none;
  }

  .home-about-cta:hover {
    background-color: var(--color-brand-primary);
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    #home-about-{{ section.id }} {
      padding-top: calc({{ section.settings.padding_top }}px * 0.7);
      padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.7);
    }
    .home-about-container {
      grid-template-columns: 1fr;
      gap: 32px;
      text-align: center;
    }
    .home-about-content {
      align-items: center;
      width: 100%;
    }
    .home-about-title {
      font-size: 28px;
    }
    .home-about-cta {
      width: 100%;
      box-sizing: border-box;
      font-size: 16px;
      padding: 16px 20px;
      text-align: center;
      justify-content: center;
    }
    .home-about-benefits {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .home-about-disclosure-line {
      text-align: center;
    }
  }
{%- endstyle -%}

<div id="home-about-{{ section.id }}">
  <div class="home-about-container">
    <div class="home-about-image-wrap">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 800 | image_tag: widths: '400,600,800', sizes: '(max-width: 900px) 90vw, 45vw', loading: 'lazy', class: 'home-about-img', alt: section.settings.title | escape }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="home-about-content">
      {%- if section.settings.badge_text != blank -%}
        <div class="home-about-badge">{{ section.settings.badge_text }}</div>
      {%- endif -%}
      
      <h2 class="home-about-title">{{ section.settings.title }}</h2>
      
      <div class="home-about-text">
        {{ section.settings.story_text }}
      </div>

      <!-- Benefit Row -->
      <div class="home-about-benefits">
        <!-- Benefit 1 -->
        <div class="home-about-benefit-item">
          <div class="home-about-benefit-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <span class="home-about-benefit-text">{{ section.settings.benefit_1 }}</span>
        </div>
        <!-- Benefit 2 -->
        <div class="home-about-benefit-item">
          <div class="home-about-benefit-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <span class="home-about-benefit-text">{{ section.settings.benefit_2 }}</span>
        </div>
        <!-- Benefit 3 -->
        <div class="home-about-benefit-item">
          <div class="home-about-benefit-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <span class="home-about-benefit-text">{{ section.settings.benefit_3 }}</span>
        </div>
        <!-- Benefit 4 -->
        <div class="home-about-benefit-item">
          <div class="home-about-benefit-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </div>
          <span class="home-about-benefit-text">{{ section.settings.benefit_4 }}</span>
        </div>
      </div>

      <!-- Small Disclosure Line -->
      {%- if section.settings.disclosure_text != blank -%}
        <div class="home-about-disclosure-line">
          {{ section.settings.disclosure_text }}
        </div>
      {%- endif -%}
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.about_url | default: '/products/dog-seat-belt' }}" class="home-about-cta">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About Brand Story",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "OUR DIRECT RESPONSE MISSION"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "We're Giving Away 10,000 Free Pet Seat Belts To Save Dogs' Lives"
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story body text",
      "default": "<p>When our founder lost a beloved dog in a minor car accident that a simple seatbelt would have prevented, SafePet Strap was born. We made a vow: no dog owner should ever suffer that heartbreak. That's why we are giving away 10,000 pet seat belts for 100% FREE today during our national campaign!</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder/Brand image"
    },
    {
      "type": "text",
      "id": "disclosure_text",
      "label": "Disclosure Text",
      "default": "SafePet Strap — safepetstrap.com"
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1",
      "default": "Instant Access"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2",
      "default": "We Stand By Our Work"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Benefit 3",
      "default": "Always Here To Help"
    },
    {
      "type": "text",
      "id": "benefit_4",
      "label": "Benefit 4",
      "default": "Built By Real Parents"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Read More About Us"
    },
    {
      "type": "url",
      "id": "about_url",
      "label": "About Us URL"
    },
    {
      "type": "header",
      "content": "Design & Spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background override"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "About Brand Story"
    }
  ]
}
{% endschema %}
