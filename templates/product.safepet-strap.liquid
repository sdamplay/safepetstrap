<!-- Accordion and gallery scripts -->
<script>
  (function() {
    function initGalleryAndQuantity() {
      // Gallery image swap logic
      var thumbs = document.querySelectorAll('.safepet-thumb');
      var mainImg = document.getElementById('safepet-main-img');
      
      thumbs.forEach(function(thumb) {
        thumb.addEventListener('mouseover', function() {
          var targetUrl = this.getAttribute('data-img-url');
          if (mainImg && targetUrl) {
            mainImg.src = targetUrl;
          }
          thumbs.forEach(t => t.classList.remove('active'));
          this.classList.add('active');
        });
      });

      // Quantity selector plus/minus logic
      var minusBtn = document.getElementById('safepet-qty-minus');
      var plusBtn = document.getElementById('safepet-qty-plus');
      var qtyInput = document.getElementById('Quantity-Selector');

      if (minusBtn && plusBtn && qtyInput) {
        minusBtn.addEventListener('click', function() {
          var current = parseInt(qtyInput.value) || 1;
          if (current > 1) {
            qtyInput.value = current - 1;
            qtyInput.dispatchEvent(new Event('change'));
          }
        });

        plusBtn.addEventListener('click', function() {
          var current = parseInt(qtyInput.value) || 1;
          qtyInput.value = current + 1;
          qtyInput.dispatchEvent(new Event('change'));
        });
      }

      // Dynamic Price updating listener
      var radios = document.querySelectorAll('input[name="safepet_variant_tier"]');
      var salePriceText = document.getElementById('safepet-price-display');
      var originalPriceText = document.getElementById('safepet-compare-price-display');
      var saveTagText = document.getElementById('safepet-save-display');

      function updatePrices(radio) {
        if (!radio) return;
        var tier = radio.value;
        if (tier === '1') {
          if (salePriceText) salePriceText.textContent = 'FREE';
          if (originalPriceText) originalPriceText.textContent = '$29.95';
          if (saveTagText) saveTagText.textContent = 'SAVE 100%';
        } else if (tier === '2') {
          if (salePriceText) salePriceText.textContent = '$17.95';
          if (originalPriceText) originalPriceText.textContent = '$60.00';
          if (saveTagText) saveTagText.textContent = 'SAVE 70%';
        } else if (tier === '3') {
          if (salePriceText) salePriceText.textContent = '$24.95';
          if (originalPriceText) originalPriceText.textContent = '$120.00';
          if (saveTagText) saveTagText.textContent = 'SAVE 80%';
        }
      }

      radios.forEach(function(radio) {
        radio.addEventListener('change', function() {
          updatePrices(this);
        });
        if (radio.checked) {
          updatePrices(radio);
        }
      });
    }

    function initFAQAccordions() {
      var triggers = document.querySelectorAll('.safepet-faq-trigger');
      triggers.forEach(function(trigger) {
        trigger.addEventListener('click', function() {
          var item = this.parentElement;
          var icon = this.querySelector('.safepet-faq-icon');
          
          item.classList.toggle('active');
          if (item.classList.contains('active')) {
            icon.textContent = '-';
          } else {
            icon.textContent = '+';
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initGalleryAndQuantity();
        initFAQAccordions();
      });
    } else {
      initGalleryAndQuantity();
      initFAQAccordions();
    }
  })();
</script>
