    "about_story": {
      "type": "home-about-story",
      "settings": {
        "badge_text": "OUR STORY",
        "title": "Created by Parents, <em>For Parents</em>",
        "story_text": "<p>TinyThrive was born out of bedtime routine battles and afternoon chore power struggles. As parents, we wanted to build emotional intelligence and practical routines in our kids, but standard parenting books felt like too much theory and not enough action.</p><p>We designed these printable life-skills workbooks to give parents a simple, visual roadmap that kids love following. It is our mission to support families with clear tools that create peaceful, independent routines.</p>",
        "cta_label": "Read More About Us",
        "about_url": "/pages/about-us"
      }
    },
    "faq": {
      "type": "home-faq",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "Is this a real company?",
            "answer": "<p>Yes, <strong>TinyThrive</strong> is a real brand operated by <strong>OUSI PLAY LLC</strong>. We publish premium children's life-skills workbooks. You can reach our support team anytime at <strong>support@tinythrive.com</strong> (we respond in under 24 hours). All transactions on our site are secured by SSL encryption, and every order is fully protected by our 90-Day Money-Back Guarantee.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Why is there a digital processing fee?",
            "answer": "<p>To make our workbooks accessible to as many families as possible, we cover the retail cost of the product itself. The small $1.95 digital processing fee at checkout goes directly to offset secure download hosting costs, merchant processing gate fees, and customer support resources.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get my download link?",
            "answer": "<p>Directly after your payment is processed, you will see a download button on the order confirmation screen. Additionally, we instantly email a secure PDF download link to the address you supplied at checkout. If you do not receive it in 5 minutes, please check your spam folder or email us.</p>"
          }
        }
