    "pricing_explainer": {
      "type": "home-pricing-explainer",
      "settings": {
        "badge_text": "HOW IT WORKS",
        "title": "Our Honest <strong>Free + Small Fee</strong> Model",
        "lead_text": "The workbook itself is 100% FREE. We charge a small digital processing fee of just $1.95 at checkout.",
        "body_text": "Why do we do this? We want to put this guide into the hands of as many families as possible without standard retail markups. The small digital processing fee covers secure download servers, processing gateway expenses, and customer email support.",
        "card_1_title": "Free Workbook",
        "card_1_text": "Pay $0.00 for the 150+ page PDF guide itself today.",
        "card_2_title": "Digital Processing Fee",
        "card_2_text": "A small $1.95 processing fee applies at checkout for instant link generation."
      }
    },
    "problem_agitate_solve": {
      "type": "home-problem-agitate-solve",
      "settings": {
        "badge_text": "THE PARENT CHALLENGE",
        "title": "Why Teaching Life Skills <em>Feels So Hard</em>",
        "subtitle": "We want our kids to be independent, but between screen time tantrums and daily chore battles, it's easy to feel overwhelmed.",
        "card_1_title": "1. The Nagging Cycle",
        "card_1_text": "You ask them to clean their room or brush their teeth five times. By the fifth time, you're raising your voice, they're crying, and the task still isn't done right.",
        "card_2_title": "2. Hidden Power Struggles",
        "card_2_text": "Without clear visual instructions, kids look at a messy room and feel complete brain freeze. They aren't trying to disobey you; they literally don't know where to start.",
        "card_3_title": "3. The TinyThrive Solution",
        "card_3_text": "Our printable workbooks convert complex tasks (routines, emotional control, organizing) into kid-friendly visual guides. Your child takes the lead, and you finally stop nagging."
      }
    },
    "how_it_works": {
      "type": "home-how-it-works",
      "settings": {
        "badge_text": "SIMPLE PROCESS",
        "title": "Get Started in <em>Just 3 Steps</em>",
        "subtitle": "Because these are digital PDF products, you don't have to wait for mail delivery or pay shipping costs. Get started instantly.",
        "step_1_title": "1. Order Online",
        "step_1_text": "Claim your FREE workbook and pay the small secure digital processing fee at checkout.",
        "step_2_title": "2. Instant Email Delivery",
        "step_2_text": "Check your email inbox immediately after purchase. Your secure PDF download link is delivered in under 2 minutes.",
        "step_3_title": "3. Print & Use",
        "step_3_text": "Open the PDF, print the worksheets at home or your local print shop, and hand them to your child to start building life skills!"
      }
    },
