{%- comment -%}
  SafePet Strap™ — Modern Streetwear Stencil / Graffiti Badge
  ===========================================================
  High-converting, sleek modern street/stencil art badge for the 2-Year Anniversary
  "100% FREE" Dog Seat Belt offer. Engineered with clean urban stencil aesthetics,
  subtle aerosol spray glow, and physical stamp-down landing animation.
{%- endcomment -%}

<div class="safepet-graffiti-wrap" id="safepetGraffitiBadge-{{ section.id }}" role="button" tabindex="0" title="Click to claim your Free Seat Belt">
  <!-- Aerosol Spray Aura (Vector Layer) -->
  <svg class="safepet-spray-mist" viewBox="0 0 240 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <ellipse cx="120" cy="60" rx="100" ry="45" fill="url(#sprayGlow-{{ section.id }})" opacity="0.45" filter="blur(16px)"/>
    <circle cx="210" cy="22" r="3" fill="#DC2626" opacity="0.6"/>
    <circle cx="218" cy="18" r="1.5" fill="#DC2626" opacity="0.4"/>
    <circle cx="225" cy="28" r="2" fill="#FBBF24" opacity="0.5"/>
    <circle cx="15" cy="85" r="2.5" fill="#DC2626" opacity="0.5"/>
    <circle cx="24" cy="95" r="1.5" fill="#FBBF24" opacity="0.6"/>
    <circle cx="8" cy="75" r="1.2" fill="#DC2626" opacity="0.4"/>
    <defs>
      <radialGradient id="sprayGlow-{{ section.id }}" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(120 60) scale(100 45)">
        <stop stop-color="#DC2626"/>
        <stop offset="0.7" stop-color="#EF4444" stop-opacity="0.3"/>
        <stop offset="1" stop-color="#000000" stop-opacity="0"/>
      </radialGradient>
    </defs>
  </svg>

  <!-- The Graffiti Stencil Stamp Card -->
  <div class="safepet-graffiti-card">
    <!-- Industrial Stencil Corner Notches -->
    <div class="safepet-stencil-cut safepet-cut-tl"></div>
    <div class="safepet-stencil-cut safepet-cut-tr"></div>
    <div class="safepet-stencil-cut safepet-cut-bl"></div>
    <div class="safepet-stencil-cut safepet-cut-br"></div>

    <!-- Top Urban Header -->
    <div class="safepet-graffiti-top">
      <span class="safepet-tag-spray-dot"></span>
      <span class="safepet-graffiti-kicker">2-YEAR ANNIVERSARY DROP</span>
      <span class="safepet-tag-spray-dot"></span>
    </div>

    <!-- Main Graffiti Stencil Text Row -->
    <div class="safepet-graffiti-main">
      <div class="safepet-stencil-text" data-text="100% FREE">100% FREE</div>
      <div class="safepet-graffiti-side-tag">
        <span class="safepet-side-pill">BATCH #02</span>
        <span class="safepet-side-sub">$0.00 TODAY</span>
      </div>
    </div>

    <!-- Urban Stencil Bar / Drips -->
    <div class="safepet-graffiti-tape-strip">
      <div class="safepet-tape-line"></div>
      <span class="safepet-tape-text">LIMITED ALLOCATION • 500 UNITS</span>
      <div class="safepet-tape-line"></div>
    </div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@700;800&display=swap');

  /* Container & Placement */
  .safepet-graffiti-wrap {
    position: absolute;
    top: 18px;
    left: 18px;
    z-index: 12;
    cursor: pointer;
    user-select: none;
    perspective: 800px;
    -webkit-tap-highlight-color: transparent;
    opacity: 0;
    transform: rotate(-8deg) scale(1.3) translateY(-18px);
    animation: safepetGraffitiStamp 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.35s forwards;
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .safepet-graffiti-wrap:hover {
    transform: rotate(-2deg) scale(1.05) translateY(-2px);
    filter: drop-shadow(0 12px 24px rgba(220, 38, 38, 0.35));
  }

  .safepet-graffiti-wrap:active {
    transform: rotate(-3deg) scale(0.98);
  }

  /* Spray Mist Vector Behind */
  .safepet-spray-mist {
    position: absolute;
    top: -24px;
    left: -24px;
    width: calc(100% + 48px);
    height: calc(100% + 48px);
    pointer-events: none;
    z-index: 1;
  }

  /* Main Stencil Card */
  .safepet-graffiti-card {
    position: relative;
    z-index: 2;
    background: linear-gradient(135deg, #0d121c 0%, #151b26 100%);
    border: 2px solid #dc2626;
    padding: 8px 14px 7px 14px;
    border-radius: 8px;
    box-shadow: 
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 4px 16px rgba(0, 0, 0, 0.45),
      0 0 20px rgba(220, 38, 38, 0.3);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  /* Spray Texture Background Effect */
  .safepet-graffiti-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #dc2626, #ef4444, #f59e0b, #dc2626);
    background-size: 200% 100%;
    animation: safepetTapeGlow 4s linear infinite;
  }

  /* Industrial Stencil Corner Notches */
  .safepet-stencil-cut {
    position: absolute;
    width: 6px;
    height: 6px;
    background: #ffffff;
    opacity: 0.12;
    pointer-events: none;
  }
  .safepet-cut-tl { top: 0; left: 0; clip-path: polygon(0 0, 100% 0, 0 100%); }
  .safepet-cut-tr { top: 0; right: 0; clip-path: polygon(0 0, 100% 0, 100% 100%); }
  .safepet-cut-bl { bottom: 0; left: 0; clip-path: polygon(0 0, 0 100%, 100% 100%); }
  .safepet-cut-br { bottom: 0; right: 0; clip-path: polygon(100% 0, 0 100%, 100% 100%); }

  /* Top Kicker */
  .safepet-graffiti-top {
    display: flex;
    align-items: center;
    gap: 6px;
    line-height: 1;
  }

  .safepet-tag-spray-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: #ef4444;
    box-shadow: 0 0 6px #ef4444;
    flex-shrink: 0;
  }

  .safepet-graffiti-kicker {
    font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: 1.2px;
    color: #fca5a5;
    text-transform: uppercase;
  }

  /* Main Row */
  .safepet-graffiti-main {
    display: flex;
    align-items: center;
    gap: 10px;
    line-height: 0.95;
    margin: 1px 0;
  }

  /* Street Stencil Typography */
  .safepet-stencil-text {
    font-family: 'Bebas Neue', Impact, 'Arial Black', sans-serif;
    font-size: 32px;
    letter-spacing: 1px;
    color: #ffffff;
    text-transform: uppercase;
    position: relative;
    text-shadow: 
      0 2px 8px rgba(0, 0, 0, 0.8),
      0 0 16px rgba(220, 38, 38, 0.6);
    background: linear-gradient(180deg, #ffffff 40%, #fee2e2 75%, #fca5a5 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Stencil Cut Lines over text */
  .safepet-stencil-text::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 52%;
    height: 1.5px;
    background: #0d121c;
    opacity: 0.85;
    pointer-events: none;
  }

  /* Side Tag Pill */
  .safepet-graffiti-side-tag {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    border-left: 1.5px solid rgba(220, 38, 38, 0.5);
    padding-left: 8px;
  }

  .safepet-side-pill {
    font-family: 'Space Grotesk', -apple-system, sans-serif;
    font-size: 8.5px;
    font-weight: 800;
    background-color: #dc2626;
    color: #ffffff;
    padding: 2px 5px;
    border-radius: 3px;
    letter-spacing: 0.5px;
    line-height: 1;
    box-shadow: 0 1px 4px rgba(220, 38, 38, 0.4);
  }

  .safepet-side-sub {
    font-family: 'Space Grotesk', -apple-system, sans-serif;
    font-size: 8.5px;
    font-weight: 800;
    color: #fde047; /* High-contrast spray yellow */
    letter-spacing: 0.4px;
    line-height: 1.1;
  }

  /* Bottom Industrial Tape Strip */
  .safepet-graffiti-tape-strip {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 1px;
    opacity: 0.85;
  }

  .safepet-tape-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
  }

  .safepet-tape-text {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 7.5px;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* STAMP-DOWN ENTRANCE ANIMATION */
  @keyframes safepetGraffitiStamp {
    0% {
      opacity: 0;
      transform: rotate(-10deg) scale(1.4) translateY(-25px);
    }
    65% {
      opacity: 1;
      transform: rotate(-3deg) scale(0.96) translateY(2px);
    }
    85% {
      transform: rotate(-4.5deg) scale(1.02) translateY(-1px);
    }
    100% {
      opacity: 1;
      transform: rotate(-3.5deg) scale(1) translateY(0);
    }
  }

  @keyframes safepetTapeGlow {
    0% { background-position: 0% 50%; }
    100% { background-position: 200% 50%; }
  }

  /* Responsive Adjustments for Mobile Viewports */
  @media (max-width: 640px) {
    .safepet-graffiti-wrap {
      top: 12px;
      left: 12px;
      transform: rotate(-3.5deg) scale(0.88);
      transform-origin: top left;
    }
    .safepet-stencil-text {
      font-size: 27px;
    }
  }

  @media (max-width: 380px) {
    .safepet-graffiti-wrap {
      top: 8px;
      left: 8px;
      transform: rotate(-3deg) scale(0.80);
      transform-origin: top left;
    }
  }
</style>

<script>
  (function() {
    function initGraffitiScroll() {
      var badge = document.getElementById('safepetGraffitiBadge-{{ section.id }}');
      if (!badge) return;

      badge.addEventListener('click', function(e) {
        e.preventDefault();
        var target = document.getElementById('safepet-variant-selector-{{ section.id }}') ||
                     document.querySelector('.safepet-variant-selector-wrapper') ||
                     document.querySelector('form[action*="/cart/add"]');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGraffitiScroll);
    } else {
      initGraffitiScroll();
    }
  })();
</script>
