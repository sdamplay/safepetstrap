    background-color: #fffdf0;
    border: 2px solid #fde047;
  }

  .safepet-pkg-featured:hover {
    background-color: #fffdeb;
  }

  input[name="safepet_variant_tier"]:checked + .safepet-pkg-featured {
    background-color: #fffde0 !important;
    border: 2px solid #dc2626 !important;
    box-shadow: 0 4px 14px rgba(220, 38, 38, 0.1);
  }

  /* Bundle Box */
  .safepet-bundle-box {
    margin-top: 18px;
    padding: 16px;
    background-color: #f9fafb;
    border: 1.5px dashed #d1d5db;
    border-radius: 14px;
  }
  .safepet-bundle-box-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 12px;
  }
  .safepet-bundle-recommend-tag {
    font-size: 11px;
    font-weight: 700;
    color: #dc2626;
    background-color: #fef2f2;
    padding: 2px 8px;
    border-radius: 999px;
  }
  .safepet-bundle-wash-hint {
    font-size: 12px;
    color: #6b7280;
  }
  .safepet-bundle-pills {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  @media screen and (max-width: 480px) {
    .safepet-bundle-pills {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .safepet-pkg-card {
      padding: 12px 14px;
    }
    .safepet-pkg-title {
      font-size: 13px;
    }
    .safepet-pkg-subtitle {
      font-size: 11px;
    }
    .safepet-pkg-price {
      font-size: 13.5px;
    }
  }
  .safepet-bundle-pill {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background-color: #ffffff;
    border: 1.5px solid #d1d5db;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
  }
  .safepet-bundle-pill:hover {
    border-color: #9ca3af;
  }
  .safepet-bundle-pill.active {
    border-color: #dc2626 !important;
    background-color: #fff5f5 !important;
  }
  .safepet-pill-circle {
    width: 16px;
    height: 16px;
    border: 2px solid #9ca3af;
    border-radius: 50%;
    background-color: #ffffff;
    position: relative;
    flex-shrink: 0;
  }
  .safepet-bundle-pill.active .safepet-pill-circle {
    border-color: #dc2626;
  }
  .safepet-bundle-pill.active .safepet-pill-circle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #dc2626;
  }
  .safepet-pill-text-col {
    display: flex;
    flex-direction: column;
    gap: 1px;
    line-height: 1.2;
  }
  .safepet-pill-main {
    font-size: 13px;
    font-weight: 800;
    color: #111827;
  }
  .safepet-bundle-pill.active .safepet-pill-main {
    color: #dc2626;
  }
  .safepet-pill-desc {
    font-size: 11px;
    color: #6b7280;
  }
  .safepet-pill-badge {
    position: absolute;
    top: -7px;
    right: 8px;
    font-size: 9px;
    font-weight: 800;
    padding: 1px 6px;
    border-radius: 999px;
    line-height: 1.2;
    letter-spacing: 0.03em;
  }
  .safepet-pill-badge-pop {
    background-color: #f97316;
    color: #ffffff;
  }
  .safepet-pill-badge-best {
    background-color: #dc2626;
    color: #ffffff;
  }
</style>

<script>
  (function() {
    function initUltraPadSelector() {
      var container = document.getElementById('safepet-variant-selector-{{ section.id }}');
      if (!container) return;

      var sizeRadios = container.querySelectorAll('input[name="safepet_variant_tier"]');
      var bundlePills = container.querySelectorAll('.safepet-bundle-pill');
      var selectedQty = 1;

      var form = container.closest('form') || document.querySelector('form[action*="/cart/add"]');

      function updateSelector() {
        var activeRadio = container.querySelector('input[name="safepet_variant_tier"]:checked');
        if (!activeRadio) return;

        var variantId = activeRadio.getAttribute('data-variant-id');
        var unitPriceStr = activeRadio.getAttribute('data-unit-price');
        var comparePriceStr = activeRadio.getAttribute('data-compare-price');
        var variantImg = activeRadio.getAttribute('data-variant-img');

        if (form) {
          var variantInput = form.querySelector('input[name="id"]');
          if (variantInput && variantId) {
            variantInput.value = variantId;
          }
          var qtyInput = form.querySelector('input[name="quantity"]');
          if (qtyInput) {
            qtyInput.value = selectedQty;
          }
        }

        // Update gallery main image if variant has photo
        if (variantImg && variantImg !== '') {
          var heroImg = document.querySelector('.kls-hero-image img.kls-gallery-img') || document.querySelector('.kls-hero-image img');
          if (heroImg) {
            heroImg.src = variantImg;
            heroImg.removeAttribute('srcset');
          }
        }

        // Update hero price display
        var salePriceText = document.querySelector('.kls-hero-price-sale');
        var originalPriceText = document.querySelector('.kls-hero-price-original');
        var savePillText = document.querySelector('.kls-hero-save-pill');

        if (salePriceText && unitPriceStr) {
          salePriceText.textContent = unitPriceStr;
        }
        if (originalPriceText && comparePriceStr) {
          originalPriceText.textContent = comparePriceStr;
        }
        if (savePillText) {
          savePillText.textContent = 'SAVE 50%';
        }

        // Update CTA button label
        var atcBtn = form ? form.querySelector('[type="submit"]') : document.querySelector('#ProductSubmitButton-{{ section.id }}');
        if (atcBtn) {
          var labelEl = atcBtn.querySelector('.main-atc__label__text');
          if (labelEl) {
            if (selectedQty === 1) {
              labelEl.textContent = "CLAIM MY ULTRAPAD NOW →";
            } else {
              labelEl.textContent = "CLAIM " + selectedQty + " ULTRAPADS NOW →";
            }
          }
        }
      }

      sizeRadios.forEach(function(radio) {
        radio.addEventListener('change', function() {
          updateSelector();
        });
      });

      bundlePills.forEach(function(pill) {
        pill.addEventListener('click', function() {
          bundlePills.forEach(function(p) { p.classList.remove('active'); });
          pill.classList.add('active');
          selectedQty = parseInt(pill.getAttribute('data-bundle-qty'), 10) || 1;
          updateSelector();
        });
      });

      var sizeGuideBtn = container.querySelector('#safepetSizeGuideTrigger-{{ section.id }}');
      if (sizeGuideBtn) {
        sizeGuideBtn.addEventListener('click', function(e) {
          e.preventDefault();
          var heroImg = document.querySelector('.kls-hero-image img.kls-gallery-img') || document.querySelector('.kls-hero-image img');
          if (heroImg) {
            heroImg.src = "{{ 'ultrapad-size-guide.jpg' | asset_url }}";
            heroImg.removeAttribute('srcset');
            heroImg.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });
      }

      // Initial execution
      updateSelector();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initUltraPadSelector);
    } else {
      initUltraPadSelector();
    }
  })();
</script>
{%- else -%}
  <div class="safepet-variant-selector-wrapper" id="safepet-variant-selector-{{ section.id }}">
    
    <!-- Custom Personalization Fields for ID Tag Page -->
    {%- if product.handle == 'personalized-id-tag' -%}
      <div class="safepet-custom-fields-wrap">
        <h4 class="safepet-custom-fields-title">Personalize Your ID Tag</h4>
        <div class="safepet-custom-field-group">
          <label for="idTagDogName">Dog's Name *</label>
          <input type="text" id="idTagDogName" name="properties[Dog's Name]" placeholder="e.g. Max" maxlength="20" required>
        </div>
        <div class="safepet-custom-field-group">
          <label for="idTagPhone">Tag Phone Number *</label>
          <input type="tel" id="idTagPhone" name="properties[Tag Phone Number]" placeholder="e.g. 123-456-7890" maxlength="25" required>
        </div>
      </div>
    {%- endif -%}

    <!-- Standard Option Pills Selector -->
    {%- unless product.has_only_default_variant -%}
      <div class="safepet-standard-variants">
        {%- for option in product.options_with_values -%}
          <div class="safepet-variant-option" data-option-index="{{ forloop.index0 }}">
            <div class="safepet-option-header-row">
              <span class="safepet-variant-option-label">Select {{ option.name }}:</span>
              {%- if product.handle == 'harness' and option.name == 'Size' -%}
                <button type="button" class="safepet-size-chart-trigger" id="harnessPageSizeChartTrigger">
                  📏 View Sizing Table
                </button>
              {%- endif -%}
            </div>
            
            <div class="safepet-variant-pills">
              {%- for value in option.values -%}
                {%- assign active = false -%}
                {%- if option.selected_value == value -%}
                  {%- assign active = true -%}
                {%- endif -%}
                {%- if product.handle == 'harness' and value == 'XS' -%}
                  {%- continue -%}
                {%- endif -%}
                {%- assign weight_sub = '' -%}
                {%- if product.handle == 'harness' and option.name == 'Size' -%}
                  {%- assign val_up = value | upcase -%}
                  {%- case val_up -%}
                    {%- when 'S' -%}{%- assign weight_sub = '10–28 lbs' -%}
                    {%- when 'M' -%}{%- assign weight_sub = '28–50 lbs' -%}
                    {%- when 'L' -%}{%- assign weight_sub = '45–70 lbs' -%}
                    {%- when 'XL' -%}{%- assign weight_sub = '70–132 lbs' -%}
                  {%- endcase -%}
                {%- endif -%}
                <button type="button" 
                        class="safepet-variant-pill{% if active %} active{% endif %}{% if weight_sub != blank %} safepet-variant-pill--with-weight{% endif %}" 
                        data-value="{{ value | escape }}">
                  <span class="safepet-pill-name">{{ value }}</span>
                  {%- if weight_sub != blank -%}
                    <span class="safepet-pill-weight">{{ weight_sub }}</span>
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endunless -%}
  </div>

  {%- if product.handle == 'harness' -%}
    <!-- Sizing Table Modal for Harness Page -->
    <div class="safepet-harness-size-modal" id="harnessPageSizeModal" aria-hidden="true" role="dialog">
      <div class="safepet-harness-size-card">
        <button type="button" class="safepet-harness-size-close" id="harnessPageSizeClose">×</button>
        <div class="safepet-harness-size-body">
          <img src="{{ 'harness-size-chart.jpg' | asset_url }}" alt="Harness Sizing Table" loading="lazy">
        </div>
      </div>
    </div>
  {%- endif -%}

