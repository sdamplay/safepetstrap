  <script>
    (function() {
      var productVariants = {{ product.variants | json }};
      var wrapper = document.getElementById('safepet-variant-selector-{{ section.id }}');
      if (!wrapper) return;
      
      var form = wrapper.closest('form');
      if (!form) return;
      
      var variantIdInput = form.querySelector('.product-variant-id');
      
      function updateVariant() {
        var selectedValues = [];
        wrapper.querySelectorAll('.safepet-variant-option').forEach(function(optionEl) {
          var activePill = optionEl.querySelector('.safepet-variant-pill.active');
          if (activePill) {
            selectedValues.push(activePill.getAttribute('data-value'));
          }
        });
        
        var matchedVariant = productVariants.find(function(variant) {
          return selectedValues.every(function(val, idx) {
            var optKey = 'option' + (idx + 1);
            return variant[optKey] === val;
          });
        });
        
        if (matchedVariant && variantIdInput) {
          variantIdInput.value = matchedVariant.id;
          
          var atcBtn = form.querySelector('[type="submit"]');
          if (atcBtn) {
            if (matchedVariant.available) {
              atcBtn.removeAttribute('disabled');
              var btnText = atcBtn.querySelector('.main-atc__label__text');
              if (btnText) btnText.textContent = "ADD TO CART";
            } else {
              atcBtn.setAttribute('disabled', 'true');
              var btnText = atcBtn.querySelector('.main-atc__label__text');
              if (btnText) btnText.textContent = "SOLD OUT";
            }
          }
        }
      }
      
      wrapper.querySelectorAll('.safepet-variant-pill').forEach(function(pill) {
        pill.addEventListener('click', function() {
          var container = pill.closest('.safepet-variant-pills');
          container.querySelectorAll('.safepet-variant-pill').forEach(function(p) {
            p.classList.remove('active');
          });
          pill.classList.add('active');
          updateVariant();
        });
      });
      
      if (form && form.querySelector('[name="properties[Dog\'s Name]"]')) {
        form.addEventListener('submit', function(e) {
          var dogName = form.querySelector('[name="properties[Dog\'s Name]"]').value.trim();
          var phone = form.querySelector('[name="properties[Tag Phone Number]"]').value.trim();
          
          if (!dogName || !phone) {
            e.preventDefault();
            e.stopPropagation();
            alert('Please fill out your Dog\'s Name and Tag Phone Number before adding to cart.');
          }
        });
      }
      
      var trigger = document.getElementById('harnessPageSizeChartTrigger');
      var modal = document.getElementById('harnessPageSizeModal');
      var closeBtn = document.getElementById('harnessPageSizeClose');
      
      if (trigger && modal) {
        trigger.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          modal.classList.add('active');
          modal.setAttribute('aria-hidden', 'false');
        });
        
        if (closeBtn) {
          closeBtn.addEventListener('click', function() {
            modal.classList.remove('active');
            modal.setAttribute('aria-hidden', 'true');
          });
        }
        
        modal.addEventListener('click', function(e) {
          if (e.target === this) {
            modal.classList.remove('active');
            modal.setAttribute('aria-hidden', 'true');
          }
        });
      }
    })();
  </script>
