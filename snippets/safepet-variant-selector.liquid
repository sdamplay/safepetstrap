          <span class="safepet-pill-main">2 Pads</span>
          <span class="safepet-pill-desc">1 In Wash / 1 In Use</span>
        </div>
      </div>

      <div class="safepet-bundle-pill" data-bundle-qty="3">
        <span class="safepet-pill-badge safepet-pill-badge-best">BEST VALUE</span>
        <div class="safepet-pill-circle"></div>
        <div class="safepet-pill-text-col">
          <span class="safepet-pill-main">3 Pads</span>
          <span class="safepet-pill-desc">Whole Home Pack</span>
        </div>
      </div>
    </div>
  </div>
</div>

