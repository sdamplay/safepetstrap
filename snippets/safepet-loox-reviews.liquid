    }
    .safepet-loox-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .safepet-form-row {
      grid-template-columns: 1fr;
    }
    .safepet-photo-thumb-card {
      width: 110px;
      height: 110px;
    }
  }
</style>

<script>
  (function() {
    function initLooxReviews() {
      var section = document.getElementById('safepetLooxReviews-{{ section.id }}');
      if (!section) return;

      // Helpful voting logic
      var helpfulButtons = section.querySelectorAll('.safepet-helpful-btn');
      helpfulButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (this.classList.contains('voted')) return;
          var countSpan = this.querySelector('.safepet-vote-count');
          var current = parseInt(this.getAttribute('data-votes') || '0', 10);
          current += 1;
          this.setAttribute('data-votes', current);
          if (countSpan) countSpan.textContent = current;
          this.classList.add('voted');
        });
      });

      // Filter tabs logic
      var chips = section.querySelectorAll('.safepet-chip');
      var cards = section.querySelectorAll('.safepet-review-card');

      chips.forEach(function(chip) {
        chip.addEventListener('click', function() {
          chips.forEach(function(c) { c.classList.remove('active'); });
          this.classList.add('active');

          var filter = this.getAttribute('data-filter');
          cards.forEach(function(card) {
            if (filter === 'all' || filter === 'verified') {
              card.style.display = 'flex';
            } else if (filter === 'photos') {
              if (card.classList.contains('has-photo')) {
                card.style.display = 'flex';
              } else {
                card.style.display = 'none';
              }
            } else if (filter === 'five') {
              if (card.getAttribute('data-rating') === '5') {
                card.style.display = 'flex';
              } else {
                card.style.display = 'none';
              }
            }
          });
        });
      });

      // Lightbox logic
      var lightbox = document.getElementById('safepetLooxLightbox-{{ section.id }}');
      var lightboxImg = document.getElementById('safepetLightboxImg-{{ section.id }}');
      var lightboxInfo = document.getElementById('safepetLightboxInfo-{{ section.id }}');

      function openLightbox(imgSrc, card) {
        if (!lightbox || !lightboxImg) return;
        lightboxImg.src = imgSrc;
        if (card && lightboxInfo) {
          var name = card.querySelector('.safepet-author-name') ? card.querySelector('.safepet-author-name').textContent : '';
          var location = card.querySelector('.safepet-user-location') ? card.querySelector('.safepet-user-location').textContent : '';
          var stars = card.querySelector('.safepet-card-stars') ? card.querySelector('.safepet-card-stars').textContent : '★★★★★';
          var title = card.querySelector('.safepet-card-headline') ? card.querySelector('.safepet-card-headline').textContent : '';
          var body = card.querySelector('.safepet-card-body') ? card.querySelector('.safepet-card-body').textContent : '';
          var tag = card.querySelector('.safepet-car-tag') ? card.querySelector('.safepet-car-tag').innerHTML : '';

          lightboxInfo.innerHTML = '<div style="display:flex;align-items:center;gap:8px;">' +
            '<span style="font-weight:800;font-size:15px;color:#0f172a;">' + name + '</span>' +
            '<span style="font-size:10px;font-weight:700;color:#16a34a;background:#f0fdf4;padding:2px 6px;border-radius:4px;">✓ Verified Buyer</span>' +
            '</div>' +
            '<span style="font-size:12px;color:#64748b;">' + location + '</span>' +
            '<div style="color:#f59e0b;font-size:18px;letter-spacing:1px;">' + stars + '</div>' +
            '<div style="display:flex;gap:6px;flex-wrap:wrap;">' + tag + '</div>' +
            '<h4 style="font-size:16px;font-weight:800;color:#0f172a;margin:4px 0 0 0;line-height:1.3;">' + title + '</h4>' +
            '<p style="font-size:14px;color:#334155;line-height:1.6;margin:0;">' + body + '</p>';
        }
        lightbox.classList.add('open');
      }

      function closeLightbox() {
        if (lightbox) lightbox.classList.remove('open');
      }

      section.querySelectorAll('.safepet-card-image').forEach(function(imgWrap) {
        imgWrap.addEventListener('click', function() {
          var card = this.closest('.safepet-review-card');
          var fullSrc = this.getAttribute('data-full-src') || (this.querySelector('img') ? this.querySelector('img').src : '');
          openLightbox(fullSrc, card);
        });
      });

      // Photo UGC carousel thumbnail click opens corresponding card in lightbox
      section.querySelectorAll('.safepet-photo-thumb-card').forEach(function(thumb) {
        thumb.addEventListener('click', function() {
          var targetId = this.getAttribute('data-ugc-target');
          var targetCard = section.querySelector('.safepet-review-card[data-review-id="' + targetId + '"]');
          var img = this.querySelector('img');
          if (img) {
            openLightbox(img.src, targetCard);
          }
        });
      });

      if (lightbox) {
        var closeBtn = lightbox.querySelector('.safepet-lightbox-close');
        var overlay = lightbox.querySelector('.safepet-lightbox-overlay');
        if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
        if (overlay) overlay.addEventListener('click', closeLightbox);
      }

      // Write a Review Modal
      var writeModal = document.getElementById('safepetReviewModal-{{ section.id }}');
      var writeTrigger = document.getElementById('safepetWriteReviewBtn-{{ section.id }}');

      if (writeTrigger && writeModal) {
        writeTrigger.addEventListener('click', function() {
          writeModal.classList.add('open');
        });

        var modalClose = writeModal.querySelector('.safepet-modal-close');
        var modalOverlay = writeModal.querySelector('.safepet-review-modal-overlay');
        if (modalClose) modalClose.addEventListener('click', function() { writeModal.classList.remove('open'); });
        if (modalOverlay) modalOverlay.addEventListener('click', function() { writeModal.classList.remove('open'); });

        // Star picker in modal
        var starPicker = document.getElementById('safepetStarPicker-{{ section.id }}');
        if (starPicker) {
          var stars = starPicker.querySelectorAll('.safepet-star-pick');
          stars.forEach(function(star) {
            star.addEventListener('click', function() {
              var val = parseInt(this.getAttribute('data-star') || '5', 10);
              stars.forEach(function(s, idx) {
                if (idx < val) s.classList.add('active');
                else s.classList.remove('active');
              });
            });
          });
        }

        // Form submit
        var form = document.getElementById('safepetReviewForm-{{ section.id }}');
        if (form) {
          form.addEventListener('submit', function(e) {
            e.preventDefault();
            var success = form.querySelector('.safepet-form-success');
            var btn = form.querySelector('.safepet-submit-review-btn');
            if (success) success.style.display = 'block';
            if (btn) btn.style.display = 'none';
            setTimeout(function() {
              writeModal.classList.remove('open');
            }, 2500);
          });
        }
      }

      // Load more button logic
      var loadMoreBtn = document.getElementById('safepetLoadMoreReviews-{{ section.id }}');
      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', function() {
          this.textContent = 'All 2,184 Verified Reviews Displayed';
          this.style.opacity = '0.6';
          this.style.pointerEvents = 'none';
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLooxReviews);
    } else {
      initLooxReviews();
    }
  })();
</script>

