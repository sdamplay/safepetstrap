        <span class="safepet-loox-dot"></span>
        <span>VERIFIED CUSTOMER PROOF</span>
      </div>
      <h2 class="safepet-loox-title">{{ section.settings.heading | default: "Over 25,000+ Dogs Protected On Every Drive" }}</h2>
      <p class="safepet-loox-subtitle">{{ section.settings.subheading | default: "Read verified stories and unedited photos from dog parents who trust SafePet Strap on the road." }}</p>
    </div>

    <!-- AGGREGATE SUMMARY RATINGS BAR (LOOX STYLE) -->
    <div class="safepet-loox-summary-card">
      <!-- Col 1: Big Score -->
      <div class="safepet-loox-score-col">
        <div class="safepet-loox-big-score">4.9</div>
        <div class="safepet-loox-stars-row">
          <span class="safepet-star-fill">★</span>
          <span class="safepet-star-fill">★</span>
          <span class="safepet-star-fill">★</span>
          <span class="safepet-star-fill">★</span>
