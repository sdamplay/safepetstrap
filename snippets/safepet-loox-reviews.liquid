{%- assign section_id = section.id | default: 'safepet-loox' -%}

<style>
  /* ==========================================================================
     SafePet Strap™ — High-Converting Loox-Style Reviews Styles
     ========================================================================== */
  .safepet-loox-section {
    padding: 70px 20px 90px;
    background-color: #fafafa;
    color: #0f172a;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    position: relative;
    overflow: hidden;
  }

  .safepet-loox-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  /* Header */
  .safepet-loox-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 36px;
  }

  .safepet-loox-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fef2f2;
    color: #dc2626;
    border: 1px solid #fecaca;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .safepet-loox-dot {
    width: 7px;
    height: 7px;
    background: #dc2626;
    border-radius: 50%;
    animation: safepetPulseDot 2s infinite ease-in-out;
  }

  @keyframes safepetPulseDot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }

  .safepet-loox-title {
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 900;
    color: #0f172a;
    line-height: 1.18;
    margin: 0 0 12px 0;
    letter-spacing: -0.02em;
  }

  .safepet-loox-subtitle {
    font-size: clamp(14px, 1.8vw, 17px);
    color: #475569;
    line-height: 1.5;
    margin: 0;
  }

  /* Summary Card */
  .safepet-loox-summary-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 30px;
    display: grid;
    grid-template-columns: 240px 1fr 260px;
    gap: 32px;
    align-items: center;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
    margin-bottom: 40px;
  }

  .safepet-loox-score-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border-right: 1px solid #f1f5f9;
    padding-right: 24px;
  }

  .safepet-loox-big-score {
    font-size: 58px;
    font-weight: 900;
    line-height: 1;
    color: #0f172a;
    letter-spacing: -0.03em;
  }

  .safepet-loox-stars-row {
    color: #f59e0b;
    font-size: 22px;
    letter-spacing: 2px;
    margin: 8px 0;
  }

  .safepet-loox-review-count {
    font-size: 13px;
    color: #64748b;
    margin-bottom: 10px;
  }

  .safepet-loox-trust-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 700;
    color: #16a34a;
    background: #f0fdf4;
    padding: 4px 10px;
    border-radius: 9999px;
  }

  .safepet-shield-icon {
    flex-shrink: 0;
  }

  /* Breakdown Bars */
  .safepet-loox-breakdown-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
    justify-content: center;
  }

  .safepet-bar-row {
    display: grid;
    grid-template-columns: 36px 1fr 82px;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    padding: 2px 4px;
    border-radius: 6px;
    transition: background-color 0.2s ease, transform 0.15s ease;
    cursor: pointer;
  }

  .safepet-bar-row:hover {
    background-color: #f8fafc;
    transform: translateX(2px);
  }

  .safepet-bar-label {
    font-weight: 700;
    color: #1e293b;
    font-size: 12px;
    white-space: nowrap;
  }

  /* Neutral Track Trough */
  .safepet-bar-track {
    height: 10px;
    background: #edf2f7;
    border-radius: 9999px;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  /* Review-Star Orange Fill based on percentage of reviews */
  .safepet-bar-fill {
    height: 100%;
    background-color: #ffa41c;
    background: linear-gradient(90deg, #f59e0b 0%, #ffa41c 100%);
    border-radius: 9999px;
    transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .safepet-bar-num {
    text-align: right;
    color: #475569;
    font-size: 11.5px;
    font-weight: 700;
    white-space: nowrap;
  }

  /* CTA Col */
  .safepet-loox-cta-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border-left: 1px solid #f1f5f9;
    padding-left: 24px;
    gap: 14px;
  }

  .safepet-recommend-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .safepet-recommend-percent {
    font-size: 32px;
    font-weight: 900;
    color: #16a34a;
    line-height: 1;
  }

  .safepet-recommend-text {
    font-size: 12px;
    color: #475569;
    line-height: 1.35;
    margin-top: 4px;
  }

  .safepet-write-review-btn {
    width: 100%;
    background: #0f172a;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    padding: 12px 20px;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .safepet-write-review-btn:hover {
    background: #dc2626;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(220, 38, 38, 0.25);
  }

  /* UGC Photo Strip */
  .safepet-loox-photos-strip {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 20px 24px;
    margin-bottom: 30px;
  }

  .safepet-photos-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .safepet-photos-title {
    font-size: 14px;
    font-weight: 800;
    color: #0f172a;
  }

  .safepet-photos-hint {
    font-size: 12px;
    color: #64748b;
  }

  .safepet-photos-scroller {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 8px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .safepet-photos-scroller::-webkit-scrollbar {
    height: 6px;
  }
  .safepet-photos-scroller::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 999px;
  }
  .safepet-photos-scroller::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 999px;
  }

  .safepet-photo-thumb-card {
    flex: 0 0 130px;
    height: 130px;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    scroll-snap-align: start;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border: 2px solid transparent;
  }

  .safepet-photo-thumb-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);
    border-color: #dc2626;
  }

  .safepet-photo-thumb-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .safepet-photo-badge {
    position: absolute;
    bottom: 6px;
    left: 6px;
    background: rgba(15, 23, 42, 0.85);
    color: #fbbf24;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 9999px;
    backdrop-filter: blur(2px);
  }

  /* Filter Bar */
  .safepet-loox-filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .safepet-filter-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .safepet-chip {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #334155;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 16px;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .safepet-chip:hover {
    border-color: #0f172a;
    color: #0f172a;
  }

  .safepet-chip.active {
    background: #0f172a;
    border-color: #0f172a;
    color: #ffffff;
  }

  .safepet-sort-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .safepet-sort-label {
    font-size: 12px;
    font-weight: 700;
    color: #64748b;
  }

  .safepet-sort-select {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 13px;
    font-weight: 600;
    color: #0f172a;
    cursor: pointer;
  }

  /* Reviews Grid */
  .safepet-loox-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    align-items: start;
  }

  .safepet-review-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .safepet-review-card.revealed {
    animation: safepetFadeUp 0.35s ease forwards;
  }

  @keyframes safepetFadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .safepet-review-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px -4px rgba(15, 23, 42, 0.08);
  }

  .safepet-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .safepet-user-meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .safepet-avatar-circle {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .safepet-author-details {
    display: flex;
    flex-direction: column;
  }

  .safepet-name-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .safepet-author-name {
    font-size: 14px;
    font-weight: 800;
    color: #0f172a;
  }

  .safepet-verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 10px;
    font-weight: 800;
    color: #16a34a;
    background: #f0fdf4;
    padding: 2px 7px;
    border-radius: 9999px;
  }

  .safepet-user-location {
    font-size: 11px;
    color: #64748b;
    margin-top: 1px;
  }

  .safepet-review-date {
    font-size: 11px;
    color: #94a3b8;
    font-weight: 500;
  }

  .safepet-card-stars {
    color: #f59e0b;
    font-size: 16px;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }

  .safepet-car-tag {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
  }

  .safepet-car-tag span {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #475569;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 6px;
  }

  .safepet-card-image {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    cursor: zoom-in;
    margin-bottom: 14px;
    background: #f1f5f9;
  }

  .safepet-card-image img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .safepet-card-image:hover img {
    transform: scale(1.03);
  }

  .safepet-zoom-hint {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(15, 23, 42, 0.75);
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
    backdrop-filter: blur(2px);
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }

  .safepet-card-image:hover .safepet-zoom-hint {
    opacity: 1;
    background: rgba(220, 38, 38, 0.9);
  }

  .safepet-card-headline {
    font-size: 15px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.35;
    margin: 0 0 10px 0;
  }

  .safepet-card-body {
    font-size: 13.5px;
    color: #334155;
    line-height: 1.6;
    margin: 0 0 16px 0;
    flex-grow: 1;
  }

  /* Loox AI Animated Review Highlights ("main-text highlighted-text is-animated") */
  @keyframes highlight-sweep {
    from { background-position: 100% 0; }
    to   { background-position:   0% 0; }
  }

  mark.invisible-marker {
    background-color: transparent;
    color: inherit;
    font-weight: inherit;
    font-style: normal;
    text-decoration: none;
    border-radius: 0;
    position: relative;
  }

  .highlighted-text {
    position: relative;
    font-weight: 700; 
    font-style: normal; 
    border-radius: 3px;
    padding: 1px 5px;
    margin: 0 -2px;
    white-space: pre-line;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .highlighted-text.is-animated {
    background-image: 
      linear-gradient(90deg, #091218 50%, #000000 50%),
      linear-gradient(90deg, #FFF2D3 50%, #FFFFFF 50%);
    background-repeat: no-repeat, no-repeat;
    background-position: 100% 0, 100% 0;
    background-size: 200% 100%, 200% 100%;
    -webkit-background-clip: text, padding-box;
    background-clip: text, padding-box;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation: highlight-sweep 2.8s cubic-bezier(0.25, 1, 0.5, 1) 0.3s forwards;
    text-decoration: none;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  @supports (-moz-appearance: none) {
    .highlighted-text.is-animated {
      color: #0f172a;
      -webkit-text-fill-color: #0f172a;
      background-image: linear-gradient(90deg, #FFF2D3 50%, #FFFFFF 50%);
      background-size: 200% 100%;
      background-position: 100% 0;
      -webkit-background-clip: padding-box;
      background-clip: padding-box;
      animation: highlight-sweep 2.8s cubic-bezier(0.25, 1, 0.5, 1) 0.3s forwards;
    }
  }

  .highlighted-text-static { 
    color: #091218; 
    font-weight: 700; 
    font-style: normal; 
    text-decoration: none;
    border-radius: 3px;
    background-color: #FFF2D3;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    white-space: pre-line;
    padding: 1px 5px;
  }


  .safepet-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    border-top: 1px solid #f1f5f9;
    font-size: 11px;
    color: #64748b;
  }

  .safepet-verified-purchase strong {
    color: #0f172a;
  }

  .safepet-helpful-btn {
    background: transparent;
    border: 1px solid #e2e8f0;
    color: #475569;
    font-size: 11px;
    font-weight: 700;
    padding: 5px 10px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .safepet-helpful-btn:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #0f172a;
  }

  .safepet-helpful-btn.voted {
    background: #ecfdf5;
    border-color: #86efac;
    color: #16a34a;
  }

  /* Load More & Progress */
  .safepet-loox-load-more-wrap {
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .safepet-load-progress {
    font-size: 14px;
    font-weight: 600;
    color: #475569;
  }

  .safepet-load-progress strong {
    color: #0f172a;
  }

  .safepet-progress-bar-track {
    width: 260px;
    height: 6px;
    background: #e2e8f0;
    border-radius: 999px;
    overflow: hidden;
  }

  .safepet-progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #dc2626, #ef4444);
    border-radius: 999px;
    transition: width 0.4s ease;
  }

  .safepet-load-more-btn {
    background: #0f172a;
    color: #ffffff;
    font-size: 15px;
    font-weight: 800;
    padding: 14px 34px;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.15);
    margin-top: 4px;
  }

  .safepet-load-more-btn:hover {
    background: #dc2626;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(220, 38, 38, 0.3);
  }

  .safepet-load-more-btn:disabled,
  .safepet-load-more-btn.all-loaded {
    background: #94a3b8;
    cursor: default;
    transform: none;
    box-shadow: none;
  }

  /* Lightbox */
  .safepet-loox-lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .safepet-loox-lightbox.open {
    display: flex;
  }

  .safepet-lightbox-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(4px);
  }

  .safepet-lightbox-content {
    position: relative;
    background: #ffffff;
    border-radius: 20px;
    max-width: 900px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    z-index: 1;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .safepet-lightbox-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #f1f5f9;
    border: none;
    font-size: 16px;
    color: #0f172a;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background 0.15s ease;
  }

  .safepet-lightbox-close:hover {
    background: #e2e8f0;
  }

  .safepet-lightbox-body {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    min-height: 480px;
  }

  .safepet-lightbox-img-wrap {
    background: #0f172a;
    display: flex;
    align-items: center;
    justify-content: center;
    border-top-left-radius: 20px;
    border-bottom-left-radius: 20px;
    overflow: hidden;
  }

  .safepet-lightbox-img-wrap img {
    width: 100%;
    height: 100%;
    max-height: 80vh;
    object-fit: contain;
    display: block;
  }

  .safepet-lightbox-info {
    padding: 34px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Review Modal */
  .safepet-review-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .safepet-review-modal.open {
    display: flex;
  }

  .safepet-review-modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(4px);
  }

  .safepet-review-modal-content {
    position: relative;
    background: #ffffff;
    border-radius: 20px;
    max-width: 580px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 32px;
    z-index: 1;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .safepet-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #f1f5f9;
    border: none;
    font-size: 15px;
    color: #475569;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .safepet-modal-header {
    margin-bottom: 22px;
  }

  .safepet-modal-title {
    font-size: 22px;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 6px 0;
  }

  .safepet-modal-subtitle {
    font-size: 13px;
    color: #64748b;
    margin: 0;
  }

  .safepet-form-group {
    margin-bottom: 16px;
  }

  .safepet-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .safepet-form-label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: #334155;
    margin-bottom: 6px;
  }

  .safepet-form-input,
  .safepet-form-textarea {
    width: 100%;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 13px;
    color: #0f172a;
    box-sizing: border-box;
  }

  .safepet-star-picker {
