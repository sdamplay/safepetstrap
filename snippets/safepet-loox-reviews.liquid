<!-- WRITE A REVIEW MODAL -->
<div class="safepet-review-modal" id="safepetReviewModal-{{ section_id }}" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="safepet-review-modal-overlay"></div>
  <div class="safepet-review-modal-content">
    <button type="button" class="safepet-modal-close" aria-label="Close Modal">✕</button>
    <div class="safepet-modal-header">
      <h3 class="safepet-modal-title">Share Your SafePet™ Experience</h3>
      <p class="safepet-modal-subtitle">Help fellow dog parents keep their fur-babies safe on the road.</p>
    </div>
    <form class="safepet-review-form" id="safepetReviewForm-{{ section_id }}">
      <div class="safepet-form-group">
        <label class="safepet-form-label">Overall Rating *</label>
        <div class="safepet-star-picker" id="safepetStarPicker-{{ section_id }}">
          <span class="safepet-star-pick active" data-star="1">★</span>
          <span class="safepet-star-pick active" data-star="2">★</span>
          <span class="safepet-star-pick active" data-star="3">★</span>
          <span class="safepet-star-pick active" data-star="4">★</span>
          <span class="safepet-star-pick active" data-star="5">★</span>
        </div>
      </div>
      <div class="safepet-form-row">
        <div class="safepet-form-group">
          <label class="safepet-form-label" for="reviewName-{{ section_id }}">Your Name *</label>
          <input type="text" id="reviewName-{{ section_id }}" class="safepet-form-input" placeholder="e.g. Sarah M." required>
        </div>
        <div class="safepet-form-group">
          <label class="safepet-form-label" for="reviewLocation-{{ section_id }}">City, State *</label>
          <input type="text" id="reviewLocation-{{ section_id }}" class="safepet-form-input" placeholder="e.g. Austin, TX" required>
        </div>
      </div>
      <div class="safepet-form-row">
        <div class="safepet-form-group">
          <label class="safepet-form-label" for="reviewDog-{{ section_id }}">Dog Breed & Name</label>
          <input type="text" id="reviewDog-{{ section_id }}" class="safepet-form-input" placeholder="e.g. Golden Retriever (Cooper)">
        </div>
        <div class="safepet-form-group">
          <label class="safepet-form-label" for="reviewCar-{{ section_id }}">Vehicle Make / Model</label>
          <input type="text" id="reviewCar-{{ section_id }}" class="safepet-form-input" placeholder="e.g. Toyota RAV4">
        </div>
      </div>
      <div class="safepet-form-group">
        <label class="safepet-form-label" for="reviewHeadline-{{ section_id }}">Review Headline *</label>
        <input type="text" id="reviewHeadline-{{ section_id }}" class="safepet-form-input" placeholder="e.g. Best peace of mind for our highway trips!" required>
      </div>
      <div class="safepet-form-group">
        <label class="safepet-form-label" for="reviewBody-{{ section_id }}">Your Review & Story *</label>
        <textarea id="reviewBody-{{ section_id }}" class="safepet-form-textarea" rows="4" placeholder="Tell us how the SafePet Strap helped keep your dog safe and comfortable in the car..." required></textarea>
      </div>
      <div class="safepet-form-group">
        <label class="safepet-form-label">Upload Dog Photo (Optional)</label>
        <div class="safepet-file-dropzone">
          <span>📷 Click or drag photo here</span>
          <input type="file" accept="image/*" class="safepet-file-input">
        </div>
      </div>
      <button type="submit" class="safepet-submit-review-btn">Submit Verified Review</button>
      <div class="safepet-form-success" style="display:none;">
        🎉 <strong>Thank you!</strong> Your review has been submitted for verification and will appear shortly.
      </div>
    </form>
  </div>
</div>

<script>
  (function() {
    function initSafepetLooxReviews() {
      var section = document.getElementById('safepetLooxReviews-{{ section_id }}');
      if (!section) return;

      var currentBatch = 1;
      var totalBatches = 4;
      var totalReviews = 32;
      var activeFilter = 'all';

      var cards = section.querySelectorAll('.safepet-review-card');
      var loadMoreBtn = document.getElementById('safepetLoadMoreReviews-{{ section_id }}');
      var currentCountEl = section.querySelector('.safepet-current-count');
      var totalCountEl = section.querySelector('.safepet-total-count');
      var progressFill = document.getElementById('safepetProgressFill-{{ section_id }}');
      var chips = section.querySelectorAll('.safepet-chip');
      var lightbox = document.getElementById('safepetLooxLightbox-{{ section_id }}');
      var lightboxImg = document.getElementById('safepetLightboxImg-{{ section_id }}');
      var lightboxInfo = document.getElementById('safepetLightboxInfo-{{ section_id }}');

      // Update counter and progress bar
      function updateProgress() {
        var visibleCards = Array.from(cards).filter(function(card) {
          return card.style.display !== 'none';
        });

        if (currentCountEl) currentCountEl.textContent = visibleCards.length;
        if (totalCountEl) totalCountEl.textContent = totalReviews;

        var pct = Math.min(100, Math.round((visibleCards.length / totalReviews) * 100));
        if (progressFill) progressFill.style.width = pct + '%';

        if (loadMoreBtn) {
          if (visibleCards.length >= totalReviews || activeFilter !== 'all') {
            if (activeFilter !== 'all') {
              loadMoreBtn.innerHTML = '<span class="safepet-load-btn-text">Showing all ' + visibleCards.length + ' filtered reviews</span>';
              loadMoreBtn.disabled = true;
              loadMoreBtn.classList.add('all-loaded');
            } else {
              loadMoreBtn.innerHTML = '<span class="safepet-load-btn-text">✓ All ' + totalReviews + ' Verified Customer Reviews Displayed</span>';
              loadMoreBtn.disabled = true;
              loadMoreBtn.classList.add('all-loaded');
            }
          } else {
            var remaining = totalReviews - visibleCards.length;
            var nextStep = Math.min(8, remaining);
            loadMoreBtn.innerHTML = '<span class="safepet-load-btn-text">Show More Verified Reviews (+' + nextStep + ')</span>';
            loadMoreBtn.disabled = false;
            loadMoreBtn.classList.remove('all-loaded');
          }
        }
      }

      // LOAD MORE REVIEWS (Progressive batching)
      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', function() {
          if (currentBatch < totalBatches) {
            currentBatch++;
            var nextCards = section.querySelectorAll('.safepet-review-card[data-batch="' + currentBatch + '"]');
            nextCards.forEach(function(card) {
              card.style.display = 'flex';
              card.classList.add('revealed');
            });
            updateProgress();
            if (typeof window.safepetObserveHighlights === "function") { window.safepetObserveHighlights(); }
          }
        });
      }

      // Click bar row to filter by star rating
      section.querySelectorAll('.safepet-bar-row[data-filter-stars]').forEach(function(row) {
        row.addEventListener('click', function() {
          var starVal = this.getAttribute('data-filter-stars');
          var targetChip = (starVal === '5') ? section.querySelector('.safepet-chip[data-filter="five"]') : section.querySelector('.safepet-chip[data-filter="all"]');
          if (targetChip) {
            targetChip.click();
            var grid = document.getElementById('safepetLooxGrid-{{ section_id }}');
            if (grid) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });

      // FILTER CHIPS
      chips.forEach(function(chip) {
        chip.addEventListener('click', function() {
          chips.forEach(function(c) { c.classList.remove('active'); });
          this.classList.add('active');
          activeFilter = this.getAttribute('data-filter') || 'all';

          cards.forEach(function(card) {
            var tags = card.getAttribute('data-tags') || '';
            var batch = parseInt(card.getAttribute('data-batch') || '1', 10);

            if (activeFilter === 'all') {
              if (batch <= currentBatch) {
                card.style.display = 'flex';
                card.classList.add('revealed');
              } else {
                card.style.display = 'none';
              }
            } else {
              if (tags.indexOf(activeFilter) !== -1) {
                card.style.display = 'flex';
                card.classList.add('revealed');
              } else {
                card.style.display = 'none';
              }
            }
          });

          updateProgress();
        });
      });

      // HELPFUL VOTES
      var helpfulButtons = section.querySelectorAll('.safepet-helpful-btn');
      helpfulButtons.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          if (this.classList.contains('voted')) return;
          var countSpan = this.querySelector('.safepet-vote-count');
          var votes = parseInt(this.getAttribute('data-votes') || '0', 10) + 1;
          this.setAttribute('data-votes', votes);
          if (countSpan) countSpan.textContent = votes;
          this.classList.add('voted');
        });
      });

      // Loox AI Animated Highlights Observer ("main-text highlighted-text is-animated")
      function initHighlightedTextObserver() {
        var elements = section.querySelectorAll('.highlighted-text');
        if (!elements.length) return;

        if (!('IntersectionObserver' in window)) {
          elements.forEach(function(el) {
            el.classList.remove('invisible-marker');
            el.classList.add('highlighted-text-static');
          });
          return;
        }

        var highlightObserver = new IntersectionObserver(function(entries, obs) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.remove('invisible-marker');
              entry.target.classList.add('is-animated');
              entry.target.dataset.animated = 'true';
              obs.unobserve(entry.target);
            }
          });
        }, {
          root: null,
          threshold: 0.15,
          rootMargin: '0px 0px -5% 0px'
        });

        elements.forEach(function(el) {
          if (el.dataset.animated !== 'true') {
            highlightObserver.observe(el);
          }
        });

        window.safepetObserveHighlights = function() {
          var allEls = section.querySelectorAll('.highlighted-text');
          allEls.forEach(function(el) {
            if (el.dataset.animated !== 'true') {
              highlightObserver.observe(el);
            }
          });
        };
      }

      initHighlightedTextObserver();

      // LIGHTBOX MODAL
      function openLightbox(fullSrc, card) {
        if (!lightbox || !lightboxImg || !lightboxInfo) return;
        lightboxImg.src = fullSrc;

        if (card) {
          var name = card.querySelector('.safepet-author-name') ? card.querySelector('.safepet-author-name').textContent : '';
          var location = card.querySelector('.safepet-user-location') ? card.querySelector('.safepet-user-location').textContent : '';
          var tag = card.querySelector('.safepet-car-tag') ? card.querySelector('.safepet-car-tag').innerHTML : '';
          var title = card.querySelector('.safepet-card-headline') ? card.querySelector('.safepet-card-headline').textContent : '';
          var body = card.querySelector('.safepet-card-body') ? card.querySelector('.safepet-card-body').innerHTML : '';

          lightboxInfo.innerHTML =
            '<div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">' +
              '<strong style="font-size:18px;color:#0f172a;">' + name + '</strong>' +
              '<span style="font-size:11px;font-weight:700;color:#16a34a;background:#f0fdf4;padding:2px 8px;border-radius:99px;">✓ Verified Buyer</span>' +
            '</div>' +
            '<span style="font-size:12px;color:#64748b;">' + location + '</span>' +
            '<div style="color:#f59e0b;font-size:18px;margin:8px 0;">★★★★★</div>' +
            '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px;">' + tag + '</div>' +
            '<h4 style="font-size:16px;font-weight:800;color:#0f172a;margin:0 0 10px 0;line-height:1.3;">' + title + '</h4>' +
            '<p style="font-size:14px;color:#334155;line-height:1.65;margin:0;">' + body + '</p>';
        }
        lightbox.classList.add('open');
      }

      function closeLightbox() {
        if (lightbox) lightbox.classList.remove('open');
      }

      section.querySelectorAll('.safepet-card-image').forEach(function(imgWrap) {
        imgWrap.addEventListener('click', function() {
          var card = this.closest('.safepet-review-card');
          var fullSrc = this.getAttribute('data-full-src') || (this.querySelector('img') ? this.querySelector('img').src : '');
          openLightbox(fullSrc, card);
        });
      });

      // UGC Carousel Thumbnails open corresponding Lightbox review
      section.querySelectorAll('.safepet-photo-thumb-card').forEach(function(thumb) {
        thumb.addEventListener('click', function() {
          var targetId = this.getAttribute('data-ugc-target');
          var targetCard = section.querySelector('.safepet-review-card[data-review-id="' + targetId + '"]');
          var img = this.querySelector('img');
          if (img) openLightbox(img.src, targetCard);
        });
      });

      if (lightbox) {
        var closeBtn = lightbox.querySelector('.safepet-lightbox-close');
        var overlay = lightbox.querySelector('.safepet-lightbox-overlay');
        if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
        if (overlay) overlay.addEventListener('click', closeLightbox);
      }

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeLightbox();
      });

      // WRITE A REVIEW MODAL
      var writeModal = document.getElementById('safepetReviewModal-{{ section_id }}');
      var writeTrigger = document.getElementById('safepetWriteReviewBtn-{{ section_id }}');

      if (writeTrigger && writeModal) {
        writeTrigger.addEventListener('click', function() {
          writeModal.classList.add('open');
        });

        var modalClose = writeModal.querySelector('.safepet-modal-close');
        var modalOverlay = writeModal.querySelector('.safepet-review-modal-overlay');
        if (modalClose) modalClose.addEventListener('click', function() { writeModal.classList.remove('open'); });
        if (modalOverlay) modalOverlay.addEventListener('click', function() { writeModal.classList.remove('open'); });

        // Star picker in modal
        var starPicker = document.getElementById('safepetStarPicker-{{ section_id }}');
        if (starPicker) {
          var stars = starPicker.querySelectorAll('.safepet-star-pick');
          stars.forEach(function(star) {
            star.addEventListener('click', function() {
              var val = parseInt(this.getAttribute('data-star') || '5', 10);
              stars.forEach(function(s, idx) {
                if (idx < val) s.classList.add('active');
                else s.classList.remove('active');
              });
            });
          });
        }

        // Form submit
        var form = document.getElementById('safepetReviewForm-{{ section_id }}');
        if (form) {
          form.addEventListener('submit', function(e) {
            e.preventDefault();
            var success = form.querySelector('.safepet-form-success');
            var btn = form.querySelector('.safepet-submit-review-btn');
            if (success) success.style.display = 'block';
            if (btn) btn.style.display = 'none';
            setTimeout(function() {
              writeModal.classList.remove('open');
            }, 2500);
          });
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSafepetLooxReviews);
    } else {
      initSafepetLooxReviews();
    }
  })();
</script>
