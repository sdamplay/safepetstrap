      <h3 class="safepet-modal-title">Share Your Experience with SafePet Strap</h3>
      <p class="safepet-modal-sub">Help other dog parents keep their furry family members safe on the road.</p>
    </div>
    <form class="safepet-modal-form" id="safepetReviewForm-{{ section.id }}" onsubmit="return false;">
      <div class="safepet-form-group">
        <label>Overall Rating *</label>
        <div class="safepet-interactive-stars" id="safepetStarPicker-{{ section.id }}">
