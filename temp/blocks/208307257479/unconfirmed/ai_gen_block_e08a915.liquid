{% doc %}
  @prompt
    Update the existing countdown timer to count down from 3 hours and 4 seconds (3:00:04). The timer should display hours, minutes, and seconds and count down to zero.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-countdown-timer-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-align: center;
  }

  .ai-countdown-timer__title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    font-weight: 600;
  }

  .ai-countdown-timer__display-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.unit_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-countdown-timer__unit-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.label_spacing }}px;
  }

  .ai-countdown-timer__value-{{ ai_gen_id }} {
    color: {{ block.settings.number_color }};
    font-size: {{ block.settings.number_size }}px;
    font-weight: 700;
    line-height: 1;
    min-width: {{ block.settings.number_min_width }}px;
    padding: {{ block.settings.number_padding }}px;
    background-color: {{ block.settings.number_background }};
    border-radius: {{ block.settings.number_border_radius }}px;
  }

  .ai-countdown-timer__label-{{ ai_gen_id }} {
    color: {{ block.settings.label_color }};
    font-size: {{ block.settings.label_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-countdown-timer__separator-{{ ai_gen_id }} {
    color: {{ block.settings.separator_color }};
    font-size: {{ block.settings.number_size }}px;
    font-weight: 700;
    line-height: 1;
    align-self: flex-start;
    padding-top: {{ block.settings.number_padding }}px;
  }

  .ai-countdown-timer__expired-{{ ai_gen_id }} {
    color: {{ block.settings.expired_text_color }};
    font-size: {{ block.settings.expired_text_size }}px;
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-countdown-timer__value-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.number_size }}px * 0.8);
      min-width: calc({{ block.settings.number_min_width }}px * 0.8);
    }

    .ai-countdown-timer__separator-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.number_size }}px * 0.8);
    }

    .ai-countdown-timer__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.9);
    }
  }
{% endstyle %}

<countdown-timer-{{ ai_gen_id }}
  class="ai-countdown-timer-{{ ai_gen_id }}"
  data-duration="10804"
  {{ block.shopify_attributes }}
>
  {% if block.settings.title != blank %}
    <h3 class="ai-countdown-timer__title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
  {% endif %}

  <div class="ai-countdown-timer__display-{{ ai_gen_id }}">
    <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
      <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-hours>00</div>
      <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.hours_label }}</div>
    </div>

    {% if block.settings.show_separator %}
      <div class="ai-countdown-timer__separator-{{ ai_gen_id }}">:</div>
    {% endif %}

    <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
      <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-minutes>00</div>
      <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.minutes_label }}</div>
    </div>

    {% if block.settings.show_separator %}
      <div class="ai-countdown-timer__separator-{{ ai_gen_id }}">:</div>
    {% endif %}

    <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
      <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-seconds>00</div>
      <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.seconds_label }}</div>
    </div>
  </div>

  <div class="ai-countdown-timer__expired-{{ ai_gen_id }}" data-expired style="display: none;">
    {{ block.settings.expired_message }}
  </div>
</countdown-timer-{{ ai_gen_id }}>

<script>
  (function() {
    class CountdownTimer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.duration = parseInt(this.dataset.duration, 10);
        this.remainingTime = this.duration;
        this.hoursElement = this.querySelector('[data-hours]');
        this.minutesElement = this.querySelector('[data-minutes]');
        this.secondsElement = this.querySelector('[data-seconds]');
        this.displayElement = this.querySelector('.ai-countdown-timer__display-{{ ai_gen_id }}');
        this.expiredElement = this.querySelector('[data-expired]');
        this.interval = null;
      }

      connectedCallback() {
        this.startCountdown();
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }

      startCountdown() {
        this.updateDisplay();

        this.interval = setInterval(() => {
          this.remainingTime--;

          if (this.remainingTime <= 0) {
            this.remainingTime = 0;
            clearInterval(this.interval);
            this.showExpired();
          }

          this.updateDisplay();
        }, 1000);
      }

      updateDisplay() {
        const hours = Math.floor(this.remainingTime / 3600);
        const minutes = Math.floor((this.remainingTime % 3600) / 60);
        const seconds = this.remainingTime % 60;

        this.hoursElement.textContent = this.padZero(hours);
        this.minutesElement.textContent = this.padZero(minutes);
        this.secondsElement.textContent = this.padZero(seconds);
      }

      padZero(num) {
        return num.toString().padStart(2, '0');
      }

      showExpired() {
        this.displayElement.style.display = 'none';
        this.expiredElement.style.display = 'block';
      }
    }

    customElements.define('countdown-timer-{{ ai_gen_id }}', CountdownTimer{{ ai_gen_id }});
  })();
</script>

